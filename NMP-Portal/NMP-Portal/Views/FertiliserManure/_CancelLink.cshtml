@using NMP.Commons.Resources
@model NMP.Commons.ViewModels.FertiliserManureViewModel
<p class="govuk-body cancel-link">
    @if (string.IsNullOrWhiteSpace(Model.EncryptedFertId) && (!Model.IsCheckAnswer))
    {
        <a asp-action="CreateFertiliserManureCancel" asp-controller="FertiliserManure" asp-route-q="@Model.EncryptedFarmId" asp-route-r="@Model.EncryptedHarvestYear" asp-route-sessionId="@Model.SessionId">@Resource.lblCancel</a>
    }
    else
    {
        <a asp-action="CheckAnswer" asp-controller="FertiliserManure" asp-route-sessionId="@Model.SessionId">@Resource.lblCancel</a>
    }
</p>