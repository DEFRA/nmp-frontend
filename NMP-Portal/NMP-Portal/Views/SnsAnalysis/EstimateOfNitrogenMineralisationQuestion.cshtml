@using NMP.Commons.Resources
@model NMP.Commons.ViewModels.SnsAnalysisViewModel
@{
    ViewData["Title"] = $"{Resource.lblWouldYouLikeToAddAnEstimateOfNitrogenMineralisation} {Resource.lblHyphen} {Resource.AddASoilMineralNitrogenAnalysisResult}";
    var yes = Convert.ToBoolean((int)NMP.Commons.Enums.TrueFalse.True);
    var no = Convert.ToBoolean((int)NMP.Commons.Enums.TrueFalse.False);
    ViewBag.CurrentStep = (int)NMP.Commons.Enums.SnsAnalysisWizardSteps.EstimateOfNitrogenMineralisationQuestion;
}
@section BeforeContent {
    <govuk-back-link asp-action="BackActionForEstimateOfNitrogenMineralisationQuestion" asp-controller="SnsAnalysis" asp-route-sessionId=@Model.SessionId>@Resource.lblBack</govuk-back-link>
}
<form asp-action="EstimateOfNitrogenMineralisationQuestion" asp-controller="SnsAnalysis" method="post" autocomplete="off">
    @Html.AntiForgeryToken()
    @await Html.PartialAsync("~/Views/SnsAnalysis/_SnsAnalysisWizardHiddenFields.cshtml", Model)
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @if (TempData["Error"] != null)
            {
                <govuk-error-summary>
                    <govuk-error-summary-item href="#">@TempData["Error"]</govuk-error-summary-item>
                </govuk-error-summary>
            }
            <govuk-radios for="@Model.IsEstimateOfNitrogenMineralisation">
                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @Resource.lblWouldYouLikeToAddAnEstimateOfNitrogenMineralisation
                    </govuk-radios-fieldset-legend>
                    <govuk-radios-item value="@yes">@Resource.lblYes</govuk-radios-item>
                    <govuk-radios-item value="@no">@Resource.lblNo</govuk-radios-item>

                </govuk-radios-fieldset>
            </govuk-radios>
            <govuk-button type="submit" class="margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
            <partial name="./_CancelLink.cshtml" model="@Model" />
        </div>

    </div>
</form>