@using NMP.Commons.Resources
@model NMP.Commons.ViewModels.ReportViewModel

@{
    string manuerDefaultNutrientUnit = "";
    if (Model.IsManureTypeLiquid != null)
    {
        manuerDefaultNutrientUnit = Model.IsManureTypeLiquid.Value ? Resource.lblKgPerCubicMetre : Resource.lblValueKgPerTon;
    }
}

@if ((Model.DryMatterPercent.HasValue) && Model.DryMatterPercent.Value > 0)
{
    <span class='nutrient_row organic_nutrients'>
        <span>@Resource.lblDryMatterContent</span>
        <span>@string.Format("{0}%", Model.DryMatterPercent.Value)</span>
    </span>
}
@if ((Model.N.HasValue) && Model.N.Value > 0)
{
    <span class='nutrient_row organic_nutrients'>
        <span>@Resource.lblNitrogen</span>
        <span>@string.Format(manuerDefaultNutrientUnit, Model.N.Value)</span>
    </span>
}
@if ((Model.NH4N.HasValue) && Model.NH4N.Value > 0)
{

    <span class='nutrient_row organic_nutrients'>
        <span>@Resource.lblAmmoniumHypenN</span>
        <span>@string.Format(manuerDefaultNutrientUnit, Model.NH4N.Value)</span>
    </span>
}
@if ((Model.UricAcid.HasValue) && Model.UricAcid.Value > 0)
{
    <span class='nutrient_row organic_nutrients'>
        <span>@Resource.lblUricAcid</span>
        <span>@string.Format(manuerDefaultNutrientUnit, Model.UricAcid.Value)</span>
    </span>
}
@if ((Model.NO3N.HasValue) && Model.NO3N.Value > 0)
{
    <span class='nutrient_row organic_nutrients'>
        <span>@Resource.lblNitrate</span>
        <span>@string.Format(manuerDefaultNutrientUnit, Model.NO3N.Value)</span>
    </span>
}
@if ((Model.P2O5.HasValue) && Model.P2O5.Value > 0)
{
    <span class='nutrient_row organic_nutrients'>
        <span>@Resource.lblPhosphateP2O5</span>
        <span>@string.Format(manuerDefaultNutrientUnit, Model.P2O5.Value)</span>
    </span>
}
@if ((Model.K2O.HasValue) && Model.K2O.Value > 0)
{
    <span class='nutrient_row organic_nutrients'>
        <span>@Resource.lblPotashK2O</span>
        <span>@string.Format(manuerDefaultNutrientUnit, Model.K2O.Value)</span>
    </span>
}
@if ((Model.SO3.HasValue) && Model.SO3.Value > 0)
{

    <span class='nutrient_row organic_nutrients'>
        <span>@Resource.lblSulphurSO3</span>
        <span>@string.Format(manuerDefaultNutrientUnit, Model.SO3.Value)</span>
    </span>
}
@if ((Model.MgO.HasValue) && Model.MgO.Value > 0)
{
    <span class='nutrient_row organic_nutrients'>
        <span>@Resource.lblMagnesiumMgO</span>
        <span>@string.Format(manuerDefaultNutrientUnit, Model.MgO.Value)</span>
    </span>
}
