</span>
}

if (Model.ManureType.P2O5.HasValue && Model.ManureType.P2O5.Value > 0)
{
<span class="nutrient_row organic_nutrients">
    <span>@Resource.lblPhosphateP2O5</span>
    <span>@string.Format(manuerDefaultNutrientUnit, Model.ManureType.P2O5.Value)</span>
</span>
}

if (Model.ManureType.K2O.HasValue && Model.ManureType.K2O.Value > 0)
