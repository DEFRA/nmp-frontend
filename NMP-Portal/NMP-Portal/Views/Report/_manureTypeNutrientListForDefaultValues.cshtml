@using NMP.Commons.Resources
@model NMP.Commons.ViewModels.ReportViewModel

@{
    string manuerDefaultNutrientUnit = "";
    if (Model.IsManureTypeLiquid != null)
    {
        manuerDefaultNutrientUnit = Model.IsManureTypeLiquid.Value ? Resource.lblKgPerCubicMetre : Resource.lblValueKgPerTon;
    }
}

if (Model.ManureType.DryMatter.HasValue && Model.ManureType.DryMatter.Value > 0)
{
<span class="nutrient_row organic_nutrients">
    <span>@Resource.lblDryMatterContent</span>
    <span>@($"{Model.ManureType.DryMatter.Value}%")</span>
</span>
}

if (Model.ManureType.TotalN.HasValue && Model.ManureType.TotalN.Value > 0)
{
<span class="nutrient_row organic_nutrients">
    <span>@Resource.lblNitrogen</span>
    <span>@string.Format(manuerDefaultNutrientUnit, Model.ManureType.TotalN.Value)</span>
</span>
}

if (Model.ManureType.NH4N.HasValue && Model.ManureType.NH4N.Value > 0)
{
<span class="nutrient_row organic_nutrients">
    <span>@Resource.lblAmmoniumHypenN</span>
    <span>@string.Format(manuerDefaultNutrientUnit, Model.ManureType.NH4N.Value)</span>
</span>
}

if (Model.ManureType.Uric.HasValue && Model.ManureType.Uric.Value > 0)
{
<span class="nutrient_row organic_nutrients">
    <span>@Resource.lblUricAcid</span>
    <span>@string.Format(manuerDefaultNutrientUnit, Model.ManureType.Uric.Value)</span>
</span>
}

if (Model.ManureType.NO3N.HasValue && Model.ManureType.NO3N.Value > 0)
