@using NMP.Commons.Resources;
@using NMP.Commons.ViewModels;
@model FarmsViewModel
@{
    ViewData["Title"] = Resource.lblYourFarms;
    var backController = "";
    if (ViewBag.DoNotShowAboutThisService)
    {
        backController = "Dashboard";
    }
    else
    {
        backController = "AboutService";
    }
}
@section BeforeContent {
    <govuk-back-link asp-action="Index" asp-controller=@backController>@Resource.lblBack</govuk-back-link>
}

@if (TempData["Error"] != null)
{
    <govuk-error-summary>
        <govuk-error-summary-item href="#">@TempData["Error"]</govuk-error-summary-item>
    </govuk-error-summary>
}
else
{
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            @if (ViewBag.Success != null && ViewBag.Success == "true")
            {
                <govuk-notification-banner type="NotificationBannerType.Success">
                    <div class="">
                        <h3 class="govuk-notification-banner__heading"> @string.Format(Resource.lblYouHaveRemoved, ViewBag.FarmName)</h3>
                    </div>
                </govuk-notification-banner>
            }

            <h1 class="govuk-heading-l">
                @Resource.lblNutrientManagementPlansAndNitrateVulnerableZoneReports
            </h1>

            <p class="govuk-body">
                @Resource.lblSelectAFarmToCreateOrUpdateANutrientManagementPlan <br>@Resource.lblOrToSaveAnNVZReport
            </p>

            <p class="govuk-body margin-bottom-thirty">
                @Resource.lblYouCanAlso <a class="govuk-link" href="/planning/add-farm/name">@Resource.lblAddANewFarm</a>
            </p>

        </div>
    </div>

    <div class="govuk-grid-row">
        <div class="govuk-grid-column-full">

            <h2 class="govuk-heading-m">@Resource.lblYourFarms</h2>

            @if (Model != null && Model.Farms.Count > 0)
            {
                <table class="govuk-table data-table">
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header">@Resource.lblFarm</th>
                            <th scope="col" class="govuk-table__header">@Resource.lblLastUpdate</th>
                            <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">@Resource.lblViewOrChange</span></th>
                        </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                        @foreach (var farm in Model.Farms)
                        {
                            <tr class="govuk-table__row">
                                <td class="govuk-table__cell">@farm.Name</td>
                                <td class="govuk-table__cell">@(farm.ModifiedOn == null ? farm.CreatedOn.ToString("dd MMMM yyyy") : farm.ModifiedOn.Value.ToString("dd MMMM yyyy"))</td>
                                <td class="govuk-table__cell">
                                    <a asp-action="FarmSummary" asp-controller="Farm" asp-route-id="@farm.EncryptedFarmId">@Resource.lblCreateANutrientManagementPlanOrNVZReport</a>
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
                
            }
            else
            {
                <p class="govuk-body">@Resource.lblYouHaveNotAddedAnyFarms</p>
                <govuk-button-link asp-action="Name" asp-controller="Farm">@Resource.lblAddAFarm</govuk-button-link>
            }

        </div>
    </div>





}
