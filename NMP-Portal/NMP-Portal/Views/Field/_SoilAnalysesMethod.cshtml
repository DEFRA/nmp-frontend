@using NMP.Commons.Resources
@using NMP.Commons.Enums
@using NMP.Commons.ViewModels
@model SoilAnalysisViewModel

<govuk-radios for="@Model.PhosphorusMethodologyID">

    <govuk-radios-fieldset>
        <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
            @Resource.lblWhichSoilAnalysisMethodWasUsed
        </govuk-radios-fieldset-legend>
       
         <govuk-radios-hint>
            <govuk-details>
                <govuk-details-summary>
                    @Resource.lblAboutSoilAnalysisMethods
                </govuk-details-summary>

                <govuk-details-text class="explanations">
                    @Resource.lblSoilAnalysisMethodHintRb209
                    <br />
                    <br />
                    @Resource.lblSoilAnalysisMethodHintSac
                </govuk-details-text>
            </govuk-details>
        </govuk-radios-hint> 

        @if (ViewBag.SoilMethologiesList != null)
        {
            @foreach (var item in ViewBag.SoilMethologiesList)
            {
                <govuk-radios-item value="@item.Value">
                    @item.Text
                </govuk-radios-item>

            }
        }

    </govuk-radios-fieldset>
</govuk-radios>