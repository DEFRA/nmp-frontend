@using NMP.Commons.Resources
@model NMP.Commons.ViewModels.FieldViewModel

<p class="govuk-body cancel-link">
    @if (!Model.IsCheckAnswer)
    {
        <a asp-action="CreateFieldCancel" asp-controller="Field" asp-route-id="@Model.EncryptedFarmId" asp-route-sessionId="@Model.SessionId">@Resource.lblCancel</a>
    }
    else
    {
        <a asp-action="CheckAnswer" asp-controller="Field" asp-route-sessionId="@Model.SessionId">@Resource.lblCancel</a>
    }
</p>