@using NMP.Commons.Resources
@model NMP.Commons.ViewModels.PreviousCroppingViewModel
<p class="govuk-body cancel-link">
                @if (!Model.IsCheckAnswer)
                {
                    <a asp-action="Recommendations" asp-controller="Crop" asp-route-q="@Model.EncryptedFarmID" asp-route-r="@Model.EncryptedFieldID" asp-route-s="@Model.EncryptedYear" asp-route-sessionId="@Model.SessionId">@Resource.lblCancel</a>
                }
                else
                {
                    <a asp-action="CheckAnswer" asp-controller="PreviousCropping" asp-route-sessionId="@Model.SessionId">@Resource.lblCancel</a>
                }
            </p>