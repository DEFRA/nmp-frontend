@using NMP.Commons.Resources

@model dynamic

@if (Model != null)
{
    if (Model.Count <= Convert.ToInt32(Resource.FieldGreaterThanX))
    {
        @foreach (var item in Model)
        {
            @item <br />
        }
    }
    else
    {
        @string.Format(Resource.lblFarmFields, Model.Count)

        <govuk-details>
            <govuk-details-summary>
                @Resource.lblViewFields
            </govuk-details-summary>

            <govuk-details-text>
                @foreach (var item in Model)
                {
                    @item <br />
                }
            </govuk-details-text>
        </govuk-details>
    }
}