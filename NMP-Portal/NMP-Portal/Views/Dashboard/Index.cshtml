@using NMP.Commons.Resources;

@{
    ViewData["Title"] = Resource.lblPlanAndRecordNutrientApplications;
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

        <h1 class="govuk-heading-l">
            @Resource.lblPlanAndRecordNutrientApplications
        </h1>

        <hr class="margin-bottom-thirty">

        <div class="govuk-width-container">
            
            <ul class="govuk-grid-row card-group">
                <li class="govuk-grid-column-one-third card-group__item">
                    <div class="card card--clickable">
                        <h2 class="govuk-heading-m card__heading">
                            <a class="govuk-link card__link govuk-link--no-visited-state" href="@Url.Action("Index", "AboutService")">@Resource.lblNutrientManagementPlanningNMPT</a>
                        </h2>
                        <p class="govuk-body card__description">@Resource.lblCreateNutrientManagementPlansAndNitrateVulnerableZone</p>
                    </div>
                </li>



                <li class="govuk-grid-column-one-third card-group__item">
                    <div class="card card--clickable">
                        <h2 class="govuk-heading-m card__heading">
                            <a class="govuk-link card__link govuk-link--no-visited-state" asp-action="Index" asp-controller="AboutService" asp-area="Manner">@Resource.lblNutrientSupplyEstimatesFromOrganicMaterials</a>
                        </h2>
                        <p class="govuk-body card__description">@Resource.lblEstimateTheNutrientSupplyAndPotentialFinancialValue</p>
                    </div>
                </li>


            </ul>
        </div>

    </div>
</div>
