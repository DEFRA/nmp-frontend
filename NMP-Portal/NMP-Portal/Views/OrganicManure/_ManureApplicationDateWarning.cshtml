@using NMP.Commons.Resources
@using NMP.Commons.ViewModels

@model NMP.Commons.ViewModels.OrganicManureViewModel

@{
    var warningModel = new WarningMessageViewModel
    {
        IsWales = Model.FarmCountryId ==
                   (int)NMP.Commons.Enums.FarmCountry.Wales
    };

    void AddWarning(bool showWarning, string? para1, string? para2, string? para3)
    {
        if (showWarning && !string.IsNullOrWhiteSpace(para1))
        {
            warningModel.Warnings.Add(new WarningMessage
            {
                Header = para1,
                Para2 = para2,
                Para3 = para3
            });
        }
    }

    AddWarning(Model.IsClosedPeriodWarning,
        Model.ClosedPeriodWarningPara1,
        Model.ClosedPeriodWarningPara2,
        Model.ClosedPeriodWarningPara3);

    AddWarning(Model.IsApplicationJulyToSeptWarning,
        Model.ApplicationJulyToSeptPara1,
        Model.ApplicationJulyToSeptPara2,
        Model.ApplicationJulyToSeptPara3);

    AddWarning(Model.IsEndClosedPeriodFebruaryExistWithinThreeWeeks,
        Model.EndClosedPeriodFebruaryExistWithinThreeWeeksPara1,
        Model.EndClosedPeriodFebruaryExistWithinThreeWeeksPara2,
        Model.EndClosedPeriodFebruaryExistWithinThreeWeeksPara3);
}

@await Html.PartialAsync(
"~/Views/OrganicManure/_WarningMessagePartial.cshtml",
    warningModel)