@using NMP.Commons.Resources;
@{
    ViewData["Title"] = Resource.lblGettingHelp;
}

@section BeforeContent {
    @if(User?.Identity != null && User.Identity.IsAuthenticated)
    {
        <govuk-back-link asp-action="Index" asp-controller="Dashboard" asp-area="">@Resource.lblBack</govuk-back-link>
    }
    else
    {
        <govuk-back-link asp-action="Index" asp-controller="Home" asp-area="">@Resource.lblBack</govuk-back-link>
    }
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">@Resource.lblGettingHelp</h1>
        <h3 class="govuk-heading-m">@Resource.lblGetHelp</h3>
        <p class="govuk-body">@Html.Raw(Resource.contentGettingHelp1)</p>
        <ul class="govuk-list govuk-list--bullet">
                <li>@Html.Raw(Resource.ContentGettingHelp2)</li>
                <li>@Resource.ContentGettingHelp3</li>

            </ul>
            <p class="govuk-body">@Resource.ContentGettingHelp4</p>
            <p class="govuk-body">@Html.Raw(Resource.lblGetHelpContent)</p>
            <hr class="seperator_thirty" />
        <h3 class="govuk-heading-m">@Resource.lblGiveFeedback</h3>

            <p class="govuk-body">@Html.Raw(Resource.contentGivingFeedbackAboutThisService1)</p>
            <p class="govuk-body">@Resource.lblYourFeedbackWillHelpUsImproveThisService</p>
        </div>
    </div>