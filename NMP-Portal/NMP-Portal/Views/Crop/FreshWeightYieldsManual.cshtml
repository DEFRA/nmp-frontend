@using NMP.Commons.Resources
@using NMP.Commons.ServiceResponses
@model NMP.Commons.ViewModels.PlanViewModel
@{
    ViewData["Title"] = Resource.lblAnnualDryMatterYield;
    ViewBag.CurrentStep = (int)NMP.Commons.Enums.CropWizardSteps.GrassClass;
}

@section BeforeContent {
    <govuk-back-link asp-action=@(Model.IsCheckAnswer && (!Model.IsAnyChangeInField) && (!Model.IsCropGroupChange) && (!Model.IsCurrentSwardChange) ? "CheckAnswer" : "FreshWeightYieldsDefault") asp-controller="Crop" asp-route-q="@Model.GrassClassEncryptedCounter">@Resource.lblBack</govuk-back-link>
}
<form asp-action="FreshWeightYieldsManual" asp-controller="Crop" method="post" autocomplete="off">
    @Html.AntiForgeryToken()

    @await Html.PartialAsync("~/Views/Crop/_CropWizardHiddenFields.cshtml", Model)
    @if (Model.Crops != null && Model.Crops.Count > 0)
    {

        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">

                <h1 class="govuk-heading-l">
                    @Resource.lblEnterTheValuesForYourFreshWeightYields
                </h1>

                @for (int i = 0; i < Model.FreshWeightYields.Count; i++)
                {
                   @*  @if (ViewBag.FreshWeightYieldDetails[i].CutOrGrazing.Equals("Establishment"))
                    { *@
                        <govuk-input for="@Model.FreshWeightYields[i].FreshWeightYield" value="@(ViewBag.FreshWeightYieldDetails[i].CutOrGrazing.Equals("Establishment") ? Resource.lblHyphen:Model.FreshWeightYields[i].FreshWeightYield)"
                                 disabled="@(ViewBag.FreshWeightYieldDetails[i].CutOrGrazing.Equals("Establishment"))"
                                     input-class="govuk-input--width-5"
                                     spellcheck="false">
                            <govuk-input-label is-page-heading="false">
                                @ViewBag.FreshWeightYieldDetails[i].DisplayText
                            </govuk-input-label>
                            <govuk-input-suffix>
                                @Resource.lblTonnesPerHectare
                            </govuk-input-suffix>
                        </govuk-input>
                    @* }
                    else
                    {
                        <govuk-input for="@Model.FreshWeightYields[i].FreshWeightYield"
                                     inputmode="numeric"
                                     input-class="govuk-input--width-5"
                                     spellcheck="false">
                            <govuk-input-label is-page-heading="false">
                                @ViewBag.FreshWeightYieldDetails[i].DisplayText
                                <span class="govuk-visually-hidden">
                                    @string.Format(Resource.lblInUnit, Resource.lblTonnesPerHectare)
                                </span>
                            </govuk-input-label>
                            <govuk-input-suffix>
                                @Resource.lblTonnesPerHectare
                            </govuk-input-suffix>
                        </govuk-input>
                    } *@
                }

            </div>
        </div>

    }
    <govuk-button type="submit" class="margin-bottom-forty">
        @Resource.lblContinue
    </govuk-button>
    <p class="govuk-body cancel-link">
        @if (!Model.IsCheckAnswer)
        {
            <a asp-action="CreateCropPlanCancel" asp-controller="Crop" asp-route-q="@Model.EncryptedFarmId">@Resource.lblCancel</a>
        }
        else
        {
            <a asp-action="CheckAnswer" asp-controller="Crop">@Resource.lblCancel</a>
        }
    </p>
</form>