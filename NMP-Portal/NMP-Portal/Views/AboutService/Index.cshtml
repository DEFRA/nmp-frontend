@using NMP.Commons.Resources;
@model NMP.Commons.ViewModels.AboutServiceViewModel;
@{
    ViewData["Title"] = Resource.lblNutrientManagementPlansAndNitrateVulnerableZoneReports;
}

@section BeforeContent {
    <govuk-back-link asp-action="Index" asp-controller="Dashboard">@Resource.lblBack</govuk-back-link>
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">
            @Resource.lblNutrientManagementPlansAndNitrateVulnerableZoneReports
        </h1>
        <h2 class="govuk-heading-m">@Resource.lblWhatYouWillNeed</h2>

        <ul class="govuk-list govuk-list--bullet">
            <li>@Resource.lblFarmNameAddressAndPostcode</li>
            <li>@Resource.lblTheSizesOfYourFieldsInHectares</li>
            <li>@Resource.lblCropDetailsIncludingYieldsAndSowingDatesIfYouHaveThem</li>
            <li>@Resource.lblManureApplicationDetailsIncludingApplicationRate</li>
            <li>@Resource.lblYourMostRecentSoilAnalysisData</li>
            <li>@Resource.lblLastYearCropTypeForEachField</li>
            <li>@Resource.lblDetailsOfHowGrassFieldsHaveBeenManaged</li>
        </ul>
        <p class="govuk-body">
            @Resource.lblSomeNVZReportsAlsoRequire
        </p>
        <ul class="govuk-list govuk-list--bullet">
            <li>@Resource.lblLivestocketDails</li>
            <li>@Resource.lblManureStorageDetails</li>
        </ul>

        <h2 class="govuk-heading-m">@Resource.lblCrossBorderHoldings</h2>
        <p class="govuk-body">@Resource.lblACrossBorderHoldingHasLandInMore</p>
        <p class="govuk-body">@Resource.lblCrossBorderHoldingsContent1</p>
        <p class="govuk-body">@Resource.lblCrossBorderHoldingsContent2</p>
        <p class="govuk-body">@Resource.lblCrossBorderHoldingsContent3</p>

        <h2 class="govuk-heading-m">
            @Resource.lblNitrateVulnerableZoneWarnings
        </h2>
        <p class="govuk-body">
            @Resource.lblTheToolWillWarnYouOfPossibleBreachesOfTheNVZ
        </p>

        <h2 class="govuk-heading-m">@Resource.lblSaving_your_data</h2>
        <p class="govuk-body">@Resource.lblSaving_your_data_line1</p>
        <form class="form margin-top-forty" asp-action="Index" asp-controller="AboutService" method="post">
            @* <div class="govuk-form-group margin-bottom-forty"> *@
                <govuk-checkboxes name="DoNotShowAboutThisService" asp-for="@Model.DoNotShowAboutThisService">
                    <govuk-checkboxes-item checked="@Model.DoNotShowAboutThisService" value="true">@Resource.lblDo_not_show_this_information_again</govuk-checkboxes-item>
                </govuk-checkboxes>
            @* </div> *@
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>
    </div>
</div>

