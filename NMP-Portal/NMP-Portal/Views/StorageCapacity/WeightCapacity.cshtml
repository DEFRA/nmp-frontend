@using NMP.Commons.Resources
@model NMP.Commons.ViewModels.StorageCapacityViewModel
@{
    string title = (!string.IsNullOrEmpty(Model.EncryptedStoreCapacityId)) ? Resource.lblUpdateOrganicMaterialStorage : Resource.lblAddAManureStore;
    ViewData["Title"] = $"{string.Format(Resource.lblWhatIsTheWeightCapacityOf, Model.StoreName)} {Resource.lblHyphen} {title}";
    ViewBag.CurrentStep = (int)NMP.Commons.Enums.StorageCapacityWizardStep.WeightCapacity;
}

@section BeforeContent {
    <govuk-back-link asp-action="@((Model.IsCheckAnswer && !Model.IsMaterialTypeChange && !Model.IsStorageTypeChange) ? "CheckAnswer" : "Dimensions")" asp-controller="StorageCapacity">@Resource.lblBack</govuk-back-link>
}
@if (TempData["ErrorOnDimensions"] != null)
{
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <govuk-error-summary>
                <govuk-error-summary-item href="#">@TempData["ErrorOnDimensions"]</govuk-error-summary-item>
            </govuk-error-summary>
        </div>
    </div>
}

@if (Model != null)
{
    <form asp-action="WeightCapacity" asp-controller="StorageCapacity" method="post" autocomplete="off">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("~/Views/StorageCapacity/_StorageCapacityWizardHiddenFields.cshtml", Model)
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <govuk-input for=@Model.CapacityWeight type="number" step="any" spellcheck="false">
                    <govuk-input-label is-page-heading="true" class="govuk-label--l">
                        @string.Format(Resource.lblWhatIsTheWeightCapacityOfSuffix, Model.StoreName)<span class="govuk-visually-hidden"> @string.Format(Resource.lblInUnit, Resource.lbltonnes)</span>@Resource.lblQuestionMark
                    </govuk-input-label>
                    <govuk-input-hint>@Resource.lblThisIsCalculatedFromTheDimentionsYouEntered</govuk-input-hint>
                    <govuk-input-suffix>@Resource.lbltonnes</govuk-input-suffix>
                </govuk-input>

                <govuk-button type="submit" class="margin-bottom-forty">
                    @Resource.lblContinue
                </govuk-button>
             
                 @await Html.PartialAsync("~/views/StorageCapacity/_CancelLink.cshtml", Model)
            </div>

        </div>
    </form>
}