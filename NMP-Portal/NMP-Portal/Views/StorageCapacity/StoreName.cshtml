@using NMP.Commons.Resources
@model NMP.Commons.ViewModels.StorageCapacityViewModel
@{
    string title = (!string.IsNullOrEmpty(Model.EncryptedStoreCapacityId)) ? Resource.lblUpdateOrganicMaterialStorage : Resource.lblAddAManureStore;
    ViewData["Title"] = $"{Resource.lblWhatDoYouWantToCallThisManureStore} {Resource.lblHyphen} {title}";
    
    ViewBag.CurrentStep = (int)NMP.Commons.Enums.StorageCapacityWizardStep.StoreName;
}

@section BeforeContent {
    <govuk-back-link asp-action="BackStoreCapacityForStoreName" asp-controller="StorageCapacity" asp-route-sessionId="@Model.SessionId">@Resource.lblBack</govuk-back-link>
}
@if (TempData["ErrorOnStoreName"] != null)
{
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <govuk-error-summary>
                <govuk-error-summary-item href="#">@TempData["ErrorOnStoreName"]</govuk-error-summary-item>
            </govuk-error-summary>
        </div>
    </div>
}

@if (Model != null)
{
    <form asp-action="StoreName" asp-controller="StorageCapacity" method="post" autocomplete="off">
        @Html.AntiForgeryToken()
        @await Html.PartialAsync("~/Views/StorageCapacity/_StorageCapacityWizardHiddenFields.cshtml", Model)
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">

                <govuk-input for="@Model.StoreName" autocomplete="off">
                    <govuk-input-label is-page-heading="true" class="govuk-label--l">@Resource.lblWhatDoYouWantToCallThisManureStore</govuk-input-label>
                    <govuk-input-hint>@Resource.lblGiveTheStoreAUniqueName</govuk-input-hint>
                </govuk-input>
                <govuk-button type="submit" class="margin-bottom-forty">
                    @Resource.lblContinue
                </govuk-button>


             
                 @await Html.PartialAsync("~/views/StorageCapacity/_CancelLink.cshtml", Model)

            </div>

        </div>
    </form>
}