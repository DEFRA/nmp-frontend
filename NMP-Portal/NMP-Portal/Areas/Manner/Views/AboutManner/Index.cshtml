@using NMP.Commons.Resources;
@model NMP.Commons.ViewModels.AboutMannerViewModel;
@{
    ViewData["Title"] = Resource.lblAboutManner;
}

@section BeforeContent {
    <govuk-back-link asp-action="Index" asp-controller="Dashboard" asp-area="">@Resource.lblBack</govuk-back-link>
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h1 class="govuk-heading-l">
            @Resource.lblNutrientSupplyEstimatesFromOrganicMaterials
        </h1>
        <p class="govuk-body">
            @Resource.lblMannerEstimateAboutPageContent1
        </p>
       
        <ul class="govuk-list govuk-list--bullet">
            <li>
                @Resource.lblMannerEstimateAboutPageContent2
            </li>
            <li>
                @Resource.lblMannerEstimateAboutPageContent3
            </li>
            <li>
                @Resource.lblMannerEstimateAboutPageContent4
            </li>
        </ul>
     
        <h2 class="govuk-heading-m">
            @Resource.lblMannerEstimateAboutPageContent5
        </h2>
        
        <ul class="govuk-list govuk-list--bullet">
            <li>
                @Resource.lblMannerEstimateAboutPageContent6
            </li>
            <li>
                @Resource.lblMannerEstimateAboutPageContent7
            </li>
            <li>
                @Resource.lblMannerEstimateAboutPageContent8
            </li>
            <li>
                @Resource.lblMannerEstimateAboutPageContent9
            </li>
        </ul>
       
        <h2 class="govuk-heading-m">
            @Resource.lblMannerEstimateAboutPageContent11
        </h2>
        <ul class="govuk-list govuk-list--bullet">
            <li>
                @Resource.lblMannerEstimateAboutPageContent18
            </li>
            <li>
                @Resource.lblMannerEstimateAboutPageContent12
            </li>
            <li>
                @Resource.lblMannerEstimateAboutPageContent13
            </li>
        </ul>
        <h2 class="govuk-heading-m">
            @Resource.lblComplianceChecking
        </h2>
        <p class="govuk-body">
            @Resource.lblMannerEstimateAboutPageContent15
        </p>
        <h2 class="govuk-heading-m">
            @Resource.lblSaving_your_data
        </h2>
        <p class="govuk-body">
            @Resource.lblMannerEstimateAboutPageContent16
        </p>
        <form class="form margin-top-forty" asp-area="Manner" asp-action="Index" asp-controller="AboutManner" method="post">
            <govuk-checkboxes name="DoNotShowAboutManner" for="@Model.DoNotShowAboutManner">
                <govuk-checkboxes-item checked="@Model.DoNotShowAboutManner" value="true">@Resource.lblDo_not_show_this_information_again</govuk-checkboxes-item>
            </govuk-checkboxes>
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty">
                @Resource.lblMannerEstimateAboutPageContent19
            </govuk-button>
        </form>
    </div>
</div>