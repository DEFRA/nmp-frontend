@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep38ViewModel

@{
    ViewData["Title"] = $"{string.Format(Resource.lblHowWouldYouLikeToUpdateYourNutrientPrice, Resource.lblPotashK2OLowecase)} {Resource.lblHyphen} {Resource.lblMannerEstimate}";

}

@section BeforeContent {
    <govuk-back-link asp-action="MannerEstimationResult" asp-controller="MannerEstimation" asp-route-q="@Model.EncryptedMannerEstimateId">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="UpdatePotashPriceQuestion" method="post" asp-controller="MannerEstimation" autocomplete="off">
            @Html.AntiForgeryToken()


            @{
                var viewDataDictionary = new ViewDataDictionary(ViewData);
                viewDataDictionary["PropertyName"] = nameof(Model.UpdatePotashPriceQuestion);
                viewDataDictionary["PropertyValue"] = Model.UpdatePotashPriceQuestion;
                viewDataDictionary["Legend"] = string.Format(Resource.lblHowWouldYouLikeToUpdateYourNutrientPrice, Resource.lblPotashK2OLowecase);
                viewDataDictionary["IsNutrientDefaultProduct"] = ViewBag.isNutrientDefaultProduct;
            }

            @await Html.PartialAsync("_UpdateNutrientPriceQuestion", viewDataDictionary)
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>
        <p class="govuk-body cancel-link">
            <a class="govuk-link" asp-action="MannerEstimationResult" asp-controller="MannerEstimation" asp-route-q="@Model.EncryptedMannerEstimateId">@Resource.lblCancel</a>

        </p>
    </div>
</div>