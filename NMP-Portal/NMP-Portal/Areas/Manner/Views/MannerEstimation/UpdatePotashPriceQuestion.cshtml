@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep38ViewModel

@{
    ViewData["Title"] = $"{string.Format(Resource.lblHowWouldYouLikeToUpdateYourNutrientPrice, Resource.lblPotashK2OLowecase)} {Resource.lblHyphen} {Resource.lblMannerEstimate}";
    bool isSelected = ViewBag.isNutrientDefaultProduct ?? false;
}

@section BeforeContent {
    <govuk-back-link asp-action="MannerEstimationResult" asp-controller="MannerEstimation" asp-route-q="@Model.EncryptedMannerEstimateId">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="UpdatePotashPriceQuestion" method="post" asp-controller="MannerEstimation" autocomplete="off">
            @Html.AntiForgeryToken()
            <govuk-radios class="govuk-radios--inline" for="@Model.UpdatePotashPriceQuestion">

                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @string.Format(Resource.lblHowWouldYouLikeToUpdateYourNutrientPrice, Resource.lblPotashK2OLowecase)
                    </govuk-radios-fieldset-legend>
                    <govuk-radios-item value=@((int)NMP.Commons.Enums.UpdateNutrientPriceQuestion.UpdateByProductPrice)>@Resource.lblUpdateByProductPrice</govuk-radios-item>
                    @if (ViewBag.isNutrientDefaultProduct != null)
                    {
                        <govuk-radios-item value="@((int)NMP.Commons.Enums.UpdateNutrientPriceQuestion.UpdateByNutrientPrice)"
                                           checked="@((bool)ViewBag.isNutrientDefaultProduct)">
                            @Resource.lblUpdateByNutrientPrice
                        </govuk-radios-item>
                    }
                    else
                    {
                        <govuk-radios-item value="@((int)NMP.Commons.Enums.UpdateNutrientPriceQuestion.UpdateByNutrientPrice)">
                            @Resource.lblUpdateByNutrientPrice
                        </govuk-radios-item>
                    }
                   
                </govuk-radios-fieldset>
            </govuk-radios>
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>
        <p class="govuk-body cancel-link">
            <a class="govuk-link" asp-action="MannerEstimationResult" asp-controller="MannerEstimation" asp-route-q="@Model.EncryptedMannerEstimateId">@Resource.lblCancel</a>

        </p>
    </div>
</div>