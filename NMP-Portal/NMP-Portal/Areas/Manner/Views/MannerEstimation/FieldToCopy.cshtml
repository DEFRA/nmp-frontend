@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep16ViewModel

@{
    string title = Resource.lblMannerEstimate;
    ViewData["Title"] = $"{Resource.lblWhichFieldWouldYouLikeToUse} {Resource.lblHyphen} {title}";    

}
@section BeforeContent {
    <govuk-back-link asp-action="@(Model.IsCheckAnswer ? "CheckAnswer" : "FarmToCopy")" asp-controller="MannerEstimation" asp-route-sid="@ViewBag.SessionId">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="FieldToCopy" method="post" asp-controller="MannerEstimation" autocomplete="off" asp-route-sessionId="@ViewBag.SessionId">
            @Html.AntiForgeryToken()
            <govuk-radios for="@Model.FieldId">
                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @Resource.lblWhichFieldWouldYouLikeToUse
                    </govuk-radios-fieldset-legend>
                    <govuk-radios-hint>@Resource.lblChooseOneOption</govuk-radios-hint>

                    @if (ViewBag.FieldList != null)
                    {
                        @foreach (var item in ViewBag.FieldList)
                        {
                            <govuk-radios-item value="@item.Value">@item.Text</govuk-radios-item>
                        }
                    }
                </govuk-radios-fieldset>
            </govuk-radios>
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>

        </form>
        <p class="govuk-body cancel-link">
            <a class="govuk-link" asp-action="MannerEstimationCancel" asp-controller="MannerEstimation">@Resource.lblCancel</a>
        </p>
    </div>
</div>
