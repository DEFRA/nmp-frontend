@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep1ViewModel

@{
    string title = Resource.lblMannerEstimate;
    ViewData["Title"] = $"{Resource.lblWhatIsTheFarmName} {Resource.lblHyphen} {title}";
    string backAction = "MannerHubPage";
    var parameter=ViewBag.IsBack;
    if (!string.IsNullOrWhiteSpace(Model.EncryptedMannerEstimateId))
    {
        backAction = "MannerEstimationResult";
        parameter=Model.EncryptedMannerEstimateId;
    }
    else if (Model.IsFarmCopied)
    {
        backAction = "CopyExistingFarmAndFieldDetails";
    }
}

@section BeforeContent {
    <govuk-back-link asp-action="@backAction" asp-controller="MannerEstimation" asp-route-q="@parameter">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="FarmName" method="post" asp-controller="MannerEstimation" autocomplete="off">
            @Html.AntiForgeryToken()
            <govuk-input for="@Model.FarmName">
                <govuk-input-label class="govuk-label--l" is-page-heading="true">@Resource.lblWhatIsTheFarmName</govuk-input-label>                
            </govuk-input>
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>
        <p class="govuk-body cancel-link">
            @if (!string.IsNullOrWhiteSpace(Model.EncryptedMannerEstimateId))
    {
                <a class="govuk-link" asp-action="MannerEstimationResult" asp-controller="MannerEstimation" asp-route-q="@(!string.IsNullOrWhiteSpace(Model.EncryptedMannerEstimateId)?Model.EncryptedMannerEstimateId:null)">@Resource.lblCancel</a>
            }
            else
            {

                <a class="govuk-link" asp-action="MannerEstimationCancel" asp-controller="MannerEstimation">@Resource.lblCancel</a>
            }
        </p>
    </div>
</div>