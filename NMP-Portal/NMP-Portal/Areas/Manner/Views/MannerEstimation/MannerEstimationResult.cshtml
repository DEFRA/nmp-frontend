@using NMP.Commons.Resources
@using System.Globalization
@section BeforeContent {
    <govuk-back-link asp-action="MannerHubPage" asp-controller="MannerEstimation">@Resource.lblBackToAllNutrientSupplyEstimates</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">

        @if (ViewBag.Success != null && ViewBag.Success == "true")
        {
            <govuk-notification-banner type="NotificationBannerType.Success">
                <h3 class="govuk-notification-banner__heading">
                    @Resource.lblNutrientSupplyEstimateCreated
                </h3>
                <p class="">@Resource.lblSelectTheFarmFieldAndCropTabOrAnApplication</p>
            </govuk-notification-banner>
        }

  
        <h1 class="govuk-heading-l margin-bottom-twenty">
            @Resource.lblEstimateOfNutrientSupplyFromOrganicMaterialResults
        </h1>
    </div>
</div>
<p class="govuk-body">
    @string.Format(Resource.lblLastUpdatedDate, ViewBag.LastUpdatedOn.ToString("dd MMMM yyyy"))
</p>
<div class="govuk-grid-row margin-bottom-thirty">
    <div class="govuk-grid-column-two-thirds-from-desktop">
        <h2 class="govuk-heading-s">@Resource.lblOptionForManner</h2>
        <ul class="govuk-list govuk-list--spaced">
            <li>
                <a href="#">@Resource.lblAddAnotherOrganicMaterialApplicationToThisEstimate</a>
            </li>

            <li>
                <a href="#">@Resource.lblExportOrPrintThisEstimate</a>
            </li>
        </ul>
    </div>
</div>
<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <govuk-tabs>
            <govuk-tabs-item id="Nutrients" label=@Resource.lblNutrients>
                <h2 class="govuk-heading-m non-standard">@Resource.lblNutrients</h2>
                <div class="margin-bottom-forty">
                    <table class="govuk-table data-table width-66">
                        <thead class="govuk-table__head">
                            <tr>
                                <th scope="row" class="govuk-table__header">@Resource.lblMaterialType</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblApplicationDate</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                        @foreach (var item in ViewBag.MannerEstimations.MannerEstimationApplication)
                        {
                                <tr>
                                    <td class="govuk-table__cell">@item.ManureTypeName</td>                                    
                                        <td class="govuk-table__cell">
    @item.ApplicationDate.ToLocalTime().ToString("dd MMMM yyyy", CultureInfo.GetCultureInfo("en-GB"))
</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="margin-bottom-forty">
                    <div class="margin-bottom-forty">
                        <h2 class="govuk-heading-s table-title">@Resource.lblTotalAndCropAvailableNitrogen</h2>
                        <p class="govuk-body govuk-!-font-size-16">@Resource.lblValuesArePerHectare</p>
                        <table class="govuk-table data-table">
                            <thead class="govuk-table__head">
                                <tr>
                                    <th scope="row" class="govuk-table__header">@Resource.lblTotalNitrogen</th>
                                    <th scope="row" class="govuk-table__header">@Resource.lblCropAvailableNitrogenCurrentCrop</th>
                                    <th scope="row" class="govuk-table__header">@Resource.lblCropAvailableNitrogenFollowingCropYear2</th>
                                    <th scope="row" class="govuk-table__header">@Resource.lblNitrogenUseEfficiency</th>
                                </tr>
                            </thead>
                            <tbody class="govuk-table__body">
                            @foreach (var item in ViewBag.MannerEstimations.MannerEstimationApplication)
                            {
                                    <tr>

                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.TotalN, Resource.lblkg)</td>
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.CropAvailableNCurrentCrop, Resource.lblkg)</td>
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.CropAvailableNitrogenFollowingCropYearTwo, Resource.lblkg)</td>
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.NitrogenUseEfficiency,Resource.lblPercentage)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="margin-bottom-forty">
                        <h2 class="govuk-heading-s table-title">@Resource.lblNitrogenMineralizationAndLosses</h2>
                        <p class="govuk-body  govuk-!-font-size-16">@Resource.lblValuesArePerHectare</p>
                        <table class="govuk-table data-table">
                            <thead class="govuk-table__head">
                                <tr>
                                    <th scope="row" class="govuk-table__header">@Resource.lblMineralisedNitrogen</th>
                                    <th scope="row" class="govuk-table__header">@Resource.lblLostNitrateN</th>
                                    <th scope="row" class="govuk-table__header">@Resource.lblLostAmmoniaN</th>
                                    <th scope="row" class="govuk-table__header">@Resource.lblLostDenitrifiedN</th>
                                </tr>
                            </thead>
                                <tbody class="govuk-table__body">
                                @foreach (var item in ViewBag.MannerEstimations.MannerEstimationApplication)
                            {
                                    <tr>
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.MineralisedNitrogenLosses, Resource.lblkg)</td>
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.LostNitrateLosses, Resource.lblkg)</td>
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.LostAmmonia, Resource.lblkg)</td>
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.LostDenitrified, Resource.lblkg)</td>
                                    </tr>
                            }
                                </tbody>
                        </table>
                    </div>

                    <h2 class="govuk-heading-s table-title">@Resource.lblPhosphatePotashSulphurAndMagnesium</h2>
                    <p class="govuk-body  govuk-!-font-size-16">@Resource.lblValuesArePerHectare</p>
                    <table class="govuk-table data-table margin-bottom-none">
                        <thead class="govuk-table__head">
                            <tr>
                                <th scope="row" class="govuk-table__header">@Resource.lblTotalPhosphate</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblCropAvailablePhosphate</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblTotalPotash</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblCropAvailablePotash</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblTotalSulphur</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblCropAvailableSulphur</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblTotalMagnesium</th>
                            </tr>
                        </thead>
                            <tbody class="govuk-table__body">
                        @foreach (var item in ViewBag.MannerEstimations.MannerEstimationApplication)
                        {
                                <tr>
                                    <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.TotalP2O5, Resource.lblkg)</td>
                                    <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.CropAvailableP2O5, Resource.lblkg)</td>
                                    <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.TotalK2O, Resource.lblkg)</td>
                                    <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.CropAvailableK2O, Resource.lblkg)</td>
                                    <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.TotalSO3, Resource.lblkg)</td>
                                    <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.CropAvailableSO3, Resource.lblkg)</td>
                                    <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.TotalMgO, Resource.lblkg)</td>
                                </tr>
                        }
                            </tbody>
                    </table>

                </div>
            </govuk-tabs-item>
            <govuk-tabs-item id="FinancialValue" label=@Resource.lblFinancialValue>
               
                <h2 class="govuk-heading-m">Resource.lblFinancialValue</h2>
                    <div class="govuk-inset-text">
                    @string.Format(Resource.lblFinancialValuesTabContent1, ViewBag.FinancialValue)
                    </div>
                <h3 class="govuk-heading-s">@Resource.lblValueBreakdown</h3>
                    <div class="margin-bottom-forty">
                        <table class="govuk-table margin-bottom-forty data-table">
                            <thead class="govuk-table__head">
                                <tr class="govuk-table__row">

                                    <th scope="row" class="govuk-table__header">Material type</th>
                                    <th scope="row" class="govuk-table__header">Crop available <br>nitrogen (N)</th>
                                    <th scope="row" class="govuk-table__header">Total phosphate (P2O5)</th>
                                    <th scope="row" class="govuk-table__header">Total potash (K2O)</th>
                                    <th scope="row" class="govuk-table__header">Total value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="govuk-table__row">

                                    <td class="govuk-table__cell">Pig slurry</td>
                                    <td class="govuk-table__cell">£10</td>
                                    <td class="govuk-table__cell">£79</td>
                                    <td class="govuk-table__cell">£36</td>
                                    <td class="govuk-table__cell">£125</td>
                                </tr>

			
                            </tbody>
                        </table>
                    </div>
                <h3 class="govuk-heading-s">@Resource.lblNutrientPrices</h3>
                    <table class="govuk-table data-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header">Nutrient</th>
                                <th scope="col" class="govuk-table__header">Product</th>
                                <th scope="col" class="govuk-table__header">Product price</th>
                                <th scope="col" class="govuk-table__header">Nutrient price</th>
                                <th scope="col" class="govuk-table__header"></th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                            <tr class="govuk-table__row">
                                <td class="govuk-table__cell">Nitrogen (N)</td>
                                <td class="govuk-table__cell">
                                    Ammonium nitrate (34.5% N)
                                </td>
                                <td class="govuk-table__cell">£207 per tonne</td>
                                <td class="govuk-table__cell">60p per kg</td>
                                <td class="govuk-table__cell"><a href="nitrogen_value_one">Change</a></td>
                            </tr>
                            <tr class="govuk-table__row">
                                <td class="govuk-table__cell">Phosphate (P2O5)</td>
                                <td class="govuk-table__cell">Triple superphosphate (46% P2O5)</td>
                                <td class="govuk-table__cell">£230 per tonne</td>
                                <td class="govuk-table__cell">50p per kg</td>
                                <td class="govuk-table__cell"><a href="phosphate_value">Change</a></td>
                            </tr>
                            <tr class="govuk-table__row">
                                <td class="govuk-table__cell">Potash (K2O)</td>
                                <td class="govuk-table__cell">Muriate of potash (60% K2O)</td>
                                <td class="govuk-table__cell">£330 per tonne</td>
                                <td class="govuk-table__cell">55p per kg</td>
                                <td class="govuk-table__cell"><a href="potash_value">Change</a></td>
                            </tr>
                        </tbody>
                    </table>

            </govuk-tabs-item>
            <govuk-tabs-item id="FarmFieldAndCrop" label=@Resource.lblFarmFieldAndCrop>
                <h2 class="govuk-heading-m non-standard">@Resource.lblFarmFieldAndCrop</h2>
            </govuk-tabs-item>
            <govuk-tabs-item id="ApplicationDetails" label=@Resource.lblApplicationDetails>
                <h2 class="govuk-heading-m non-standard">@Resource.lblApplicationDetails</h2>
            </govuk-tabs-item>
        </govuk-tabs>

    </div>

</div>

    