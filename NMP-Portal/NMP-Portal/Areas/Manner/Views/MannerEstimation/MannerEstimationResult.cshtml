@using NMP.Commons.Resources
@using System.Globalization
@{
    ViewData["Title"] = $"{Resource.lblEstimateOfNutrientSupplyFromOrganicMaterialResults} {Resource.lblHyphen} {Resource.lblMannerEstimate}";
    var mannerEstimation = ViewBag.MannerEstimations.MannerEstimation;

    var registeredOrganicProducer = mannerEstimation.RegisteredOrganicProducer ? Resource.lblYes : Resource.lblNo;
    var isWithinNVZ = @mannerEstimation.IsWithinNVZ ? Resource.lblYes : Resource.lblNo;
    int applicationCount = ViewBag.MannerEstimations.MannerEstimationApplication.Count;
    int count = 0;
}
@section BeforeContent {
    <govuk-back-link asp-action="MannerHubPage" asp-controller="MannerEstimation">@Resource.lblBackToAllNutrientSupplyEstimates</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds-from-desktop">
        @if (TempData["MannerEstimationResult"] != null)
        {
            <govuk-error-summary>
                <govuk-error-summary-item href="#">@TempData["MannerEstimationResult"]</govuk-error-summary-item>
            </govuk-error-summary>
        }
        @if (ViewBag.Success != null && ViewBag.Success == "true")
        {
            @if (ViewBag.SuccessForTab != null)
            {
                <govuk-notification-banner type="NotificationBannerType.Success">
                    <h3 class="govuk-notification-banner__heading">
                        @ViewBag.SuccessForTab
                    </h3>
                </govuk-notification-banner>
            }
            else
            {
                <govuk-notification-banner type="NotificationBannerType.Success">
                    <h3 class="govuk-notification-banner__heading">
                        @Resource.lblNutrientSupplyEstimateCreated
                    </h3>
                    <p class="">@Resource.lblSelectTheFarmFieldAndCropTabOrAnApplication</p>
                </govuk-notification-banner>
            }
        }

  
        <h1 class="govuk-heading-l margin-bottom-twenty">
            @Resource.lblEstimateOfNutrientSupplyFromOrganicMaterialResults
        </h1>
    </div>
</div>
<p class="govuk-body">
    @string.Format(Resource.lblLastUpdatedDate, ViewBag.LastUpdatedOn.ToString("dd MMMM yyyy"))
</p>
<div class="govuk-grid-row margin-bottom-thirty">
    <div class="govuk-grid-column-two-thirds-from-desktop">
        <h2 class="govuk-heading-s">@Resource.lblOptionForManner</h2>
        <ul class="govuk-list govuk-list--spaced">
            <li>
                <a href="#">@Resource.lblAddAnotherOrganicMaterialApplicationToThisEstimate</a>
            </li>

            <li>
                <a asp-action="Report" asp-route-q="@ViewBag.EncryptedEstimateId">@Resource.lblExportOrPrintThisEstimate</a>
            </li>
        </ul>
    </div>
</div>
<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <govuk-tabs>
            <govuk-tabs-item id="Nutrients" label=@Resource.lblNutrients>
                <h2 class="govuk-heading-m non-standard">@Resource.lblNutrients</h2>
                <div class="margin-bottom-forty">
                    <table class="govuk-table data-table width-66">
                        <thead class="govuk-table__head">
                            <tr>      @if(applicationCount>1){
                                <th scope="row" class="govuk-table__header">@Resource.lblApplication</th>
                                }
                                <th scope="row" class="govuk-table__header">@Resource.lblMaterialType</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblApplicationDate</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                              @{
                                 count = 0;
                            }
                            @foreach (var item in ViewBag.MannerEstimations.MannerEstimationApplication)
                            {
                                count++;
                                <tr>
                                     @if(applicationCount>1){
                                    <td class="govuk-table__cell">@count</td>
                                    }
                                    <td class="govuk-table__cell">@item.ManureType</td>
                                    <td class="govuk-table__cell">
                                        @item.ApplicationDate.ToLocalTime().ToString("dd MMM yyyy", CultureInfo.GetCultureInfo("en-GB"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="margin-bottom-forty">
                    <div class="margin-bottom-forty">
                        <h2 class="govuk-heading-s table-title">@Resource.lblTotalAndCropAvailableNitrogen</h2>
                        <p class="govuk-body govuk-!-font-size-16">@Resource.lblValuesArePerHectare</p>
                        <table class="govuk-table data-table">
                            <thead class="govuk-table__head">
                                <tr>      @if(applicationCount>1){
                                <th scope="row" class="govuk-table__header">@Resource.lblApplication</th>
                                }
                                    <th scope="row" class="govuk-table__header">@Resource.lblTotalNitrogen</th>
                                    <th scope="row" class="govuk-table__header">@Resource.lblCropAvailableNitrogenCurrentCrop</th>
                                    <th scope="row" class="govuk-table__header">@Resource.lblCropAvailableNitrogenFollowingCropYear2</th>
                                    <th scope="row" class="govuk-table__header">@Resource.lblNitrogenUseEfficiency</th>
                                </tr>
                            </thead>
                            <tbody class="govuk-table__body">
                                  @{
count = 0;
                            }
                                @foreach (var item in ViewBag.MannerEstimations.MannerEstimationApplication)
                                {
                                count++;
                                    <tr>
                                         @if(applicationCount>1){
                                    <td class="govuk-table__cell">@count</td>
                                    }
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.TotalN, Resource.lblkg)</td>
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.CropAvailableNCurrentCrop, Resource.lblkg)</td>
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.CropAvailableNitrogenFollowingCropYearTwo, Resource.lblkg)</td>
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.NitrogenUseEfficiency, Resource.lblPercentage)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="margin-bottom-forty">
                        <h2 class="govuk-heading-s table-title">@Resource.lblNitrogenMineralizationAndLosses</h2>
                        <p class="govuk-body  govuk-!-font-size-16">@Resource.lblValuesArePerHectare</p>
                        <table class="govuk-table data-table">
                            <thead class="govuk-table__head">
                                <tr>      @if(applicationCount>1){
                                <th scope="row" class="govuk-table__header">@Resource.lblApplication</th>
                                }
                                    <th scope="row" class="govuk-table__header">@Resource.lblMineralisedNitrogen</th>
                                    <th scope="row" class="govuk-table__header">@Resource.lblLostNitrateN</th>
                                    <th scope="row" class="govuk-table__header">@Resource.lblLostAmmoniaN</th>
                                    <th scope="row" class="govuk-table__header">@Resource.lblLostDenitrifiedN</th>
                                </tr>
                            </thead>
                            <tbody class="govuk-table__body">
                                  @{
                                 count = 0;
                            }
                                @foreach (var item in ViewBag.MannerEstimations.MannerEstimationApplication)
                                {
                                count++;
                                    <tr>
                                         @if(applicationCount>1){
                                    <td class="govuk-table__cell">@count</td>
                                    }
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.MineralisedNitrogenLosses, Resource.lblkg)</td>
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.LostNitrateLosses, Resource.lblkg)</td>
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.LostAmmonia, Resource.lblkg)</td>
                                        <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.LostDenitrified, Resource.lblkg)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <h2 class="govuk-heading-s table-title">@Resource.lblPhosphatePotashSulphurAndMagnesium</h2>
                    <p class="govuk-body  govuk-!-font-size-16">@Resource.lblValuesArePerHectare</p>
                    <table class="govuk-table data-table margin-bottom-none">
                        <thead class="govuk-table__head">
                            <tr>      @if(applicationCount>1){
                                <th scope="row" class="govuk-table__header">@Resource.lblApplication</th>
                                }
                                <th scope="row" class="govuk-table__header">@Resource.lblTotalPhosphate</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblCropAvailablePhosphate</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblTotalPotash</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblCropAvailablePotash</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblTotalSulphur</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblCropAvailableSulphur</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblTotalMagnesium</th>
                            </tr>
                        </thead>
                        <tbody class="govuk-table__body">
                              @{
                                 count = 0;
                            }
                            @foreach (var item in ViewBag.MannerEstimations.MannerEstimationApplication)
                            {
                                count++;
                                <tr>
                                     @if(applicationCount>1){
                                    <td class="govuk-table__cell">@count</td>
                                    }
                                    <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.TotalP2O5, Resource.lblkg)</td>
                                    <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.CropAvailableP2O5, Resource.lblkg)</td>
                                    <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.TotalK2O, Resource.lblkg)</td>
                                    <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.CropAvailableK2O, Resource.lblkg)</td>
                                    <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.TotalSO3, Resource.lblkg)</td>
                                    <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.CropAvailableSO3, Resource.lblkg)</td>
                                    <td class="govuk-table__cell">@string.Format("{0:N0}{1}", item.TotalMgO, Resource.lblkg)</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </govuk-tabs-item>
            <govuk-tabs-item id="FinancialValue" label=@Resource.lblFinancialValue>

                <h2 class="govuk-heading-m">@Resource.lblFinancialValue</h2>
                <div class="govuk-inset-text">
                    @string.Format(Resource.lblFinancialValuesTabContent1, ViewBag.TotalValue)<br />
                    @Resource.lblThisIsBasedOnFertiliserNutrientPricesBelow
                </div>
                <h3 class="govuk-heading-s">@Resource.lblValueBreakdown</h3>
                <div class="margin-bottom-forty">
                    <table class="govuk-table margin-bottom-forty data-table">
                        <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                @if(applicationCount>1){
                                <th scope="row" class="govuk-table__header">@Resource.lblApplication</th>
                                }
                                <th scope="row" class="govuk-table__header">@Resource.lblMaterialType</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblDate</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblCropAvailable<br />@Resource.lblNitrogenLowercase</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblTotalPhosphate</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblTotalPotash</th>
                                <th scope="row" class="govuk-table__header">@Resource.lblTotalValue</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int count = 0;
                            }
                            @foreach (var item in ViewBag.MannerEstimations.MannerEstimationApplication)
                            {
                                count++;
                                <tr class="govuk-table__row">
                                    @if(applicationCount>1){
                                    <td class="govuk-table__cell">@count</td>
                                    }
                                    <td class="govuk-table__cell">@item.ManureType</td>
                                    <td class="govuk-table__cell">@item.ApplicationDate.ToLocalTime().ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("en-GB"))</td>
                                    <td class="govuk-table__cell">@string.Format(Resource.lblPoundWithValue, item.NitrogenValue)</td>
                                    @*  *@
                                    <td class="govuk-table__cell">@string.Format(Resource.lblPoundWithValue, item.PhosphateValue)</td>
                                    <td class="govuk-table__cell">@string.Format(Resource.lblPoundWithValue, item.PotashValue)</td>
                                    <td class="govuk-table__cell">@string.Format(Resource.lblPoundWithValue, item.NitrogenValue + item.PhosphateValue + item.PotashValue)</td>
                                </tr>
                            }

                        </tbody>
                    </table>
                </div>
                <h3 class="govuk-heading-s">@Resource.lblNutrientPrices</h3>
                <table class="govuk-table data-table">
                    <thead class="govuk-table__head">
                        <tr class="govuk-table__row">
                            <th scope="col" class="govuk-table__header">@Resource.lblNutrient</th>
                            <th scope="col" class="govuk-table__header">@Resource.lblPercentageOfNutrient</th>
                            <th scope="col" class="govuk-table__header">@Resource.lblPriceOfProduct</th>
                            <th scope="col" class="govuk-table__header">@Resource.lblPriceOfNutrient</th>
                            <th scope="col" class="govuk-table__header"></th>
                        </tr>
                    </thead>
                    <tbody class="govuk-table__body">
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@Resource.lblNitrogen</td>
                            <td class="govuk-table__cell">
                                @mannerEstimation.NitrogenProductName
                            </td>
                            <td class="govuk-table__cell">@string.Format(Resource.lblPoundValuePerTonne, mannerEstimation.NitrogenProductPrice)</td>
                            <td class="govuk-table__cell">@string.Format(Resource.lblPoundWithValue, string.Format("{0:N2} {1}", mannerEstimation.NitrogenPrice,Resource.lblPerKg))</td>
                            <td class="govuk-table__cell"><a asp-action="NutrientProduct" asp-controller="MannerEstimation" asp-route-q=@ViewBag.EncryptedEstimateId asp-route-r=@ViewBag.EncryptedNitrogenId>@Resource.lblChange</a></td>
                        </tr>
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@Resource.lblPhosphateP2O5</td>
                            <td class="govuk-table__cell">
                                @mannerEstimation.PhosphateProductName
                            </td>
                            <td class="govuk-table__cell">@string.Format(Resource.lblPoundValuePerTonne, mannerEstimation.PhosphateProductPrice)</td>
                            <td class="govuk-table__cell">@string.Format(Resource.lblPoundWithValue, string.Format("{0:N2} {1}", mannerEstimation.PhosphatePrice, Resource.lblPerKg))</td>
                            <td class="govuk-table__cell"><a asp-action="NutrientProduct" asp-controller="MannerEstimation" asp-route-q=@ViewBag.EncryptedEstimateId asp-route-r=@ViewBag.EncryptedPhosphateId>@Resource.lblChange</a></td>
                        </tr>
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell">@Resource.lblPotashK2O</td>
                            <td class="govuk-table__cell">
                                @mannerEstimation.PotashProductName
                            </td>
                            <td class="govuk-table__cell">@string.Format(Resource.lblPoundValuePerTonne, mannerEstimation.PotashProductPrice)</td>
                            <td class="govuk-table__cell">@string.Format(Resource.lblPoundWithValue, string.Format("{0:N2} {1}", mannerEstimation.PotashPrice,Resource.lblPerKg))</td>
                            <td class="govuk-table__cell"><a asp-action="NutrientProduct" asp-controller="MannerEstimation" asp-route-q=@ViewBag.EncryptedEstimateId asp-route-r=@ViewBag.EncryptedPotashId>@Resource.lblChange</a></td>
                        </tr>

                    </tbody>
                </table>

            </govuk-tabs-item>
            <govuk-tabs-item id="FarmFieldAndCrop" label=@Resource.lblFarmFieldAndCrop>
                <h2 class="govuk-heading-m non-standard">@Resource.lblFarmFieldAndCrop</h2>
                <table class="govuk-table data-table margin-bottom-forty">
                    <tbody class="govuk-table__body">

                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">@Resource.lblFarmName</th>
                            <td class="govuk-table__cell">
                                @mannerEstimation.FarmName
                            </td>
                            <td class="govuk-table__cell">
                                <a class="govuk-link" href="#">
                                    @Resource.lblChange
                                </a>
                            </td>
                        </tr>

                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">@Resource.lblCountry</th>
                            <td class="govuk-table__cell">
                                @mannerEstimation.Country
                            </td>
                            <td class="govuk-table__cell"><a class="govuk-link" href="#">@Resource.lblChange</a></td>
                        </tr>

                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">@Resource.lblPostCode</th>
                            <td class="govuk-table__cell">
                                @mannerEstimation.Postcode
                            </td>
                            <td class="govuk-table__cell"><a class="govuk-link" href="#">@Resource.lblChange</a></td>
                        </tr>

                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">@Resource.lblRegisteredOrganicProducerOnly</th>
                            <td class="govuk-table__cell">
                                @registeredOrganicProducer
                            </td>
                            <td class="govuk-table__cell"><a class="govuk-link" href="#">@Resource.lblChange</a></td>
                        </tr>

                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">@string.Format(Resource.lblAverageAnnualRainfallFor, mannerEstimation.Postcode)</th>
                            <td class="govuk-table__cell">
                                @string.Format("{0}{1}", mannerEstimation.AverageAnuualRainfall, Resource.lblmm)
                            </td>
                            <td class="govuk-table__cell"><a class="govuk-link" href="#">@Resource.lblChange</a></td>
                        </tr>

                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">@Resource.lblFieldName</th>
                            <td class="govuk-table__cell">
                                @mannerEstimation.FieldName
                            </td>
                            <td class="govuk-table__cell"><a class="govuk-link" href="#">@Resource.lblChange</a></td>
                        </tr>

                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">@Resource.lblIsInsideANitrateVulnerableZone</th>
                            <td class="govuk-table__cell">
                                @isWithinNVZ
                            </td>
                            <td class="govuk-table__cell"><a class="govuk-link" href="#">@Resource.lblChange</a></td>
                        </tr>

                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">@Resource.lblTopsoil</th>
                            <td class="govuk-table__cell">
                                @mannerEstimation.TopSoil
                            </td>
                            <td class="govuk-table__cell"><a class="govuk-link" href="#">@Resource.lblChange</a></td>
                        </tr>

                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">@Resource.lblSubSoil</th>
                            <td class="govuk-table__cell">
                                @mannerEstimation.SubSoil
                            </td>
                            <td class="govuk-table__cell"><a class="govuk-link" href="#">@Resource.lblChange</a></td>
                        </tr>

                        <tr class="govuk-table__row">
                            <th scope="row" class="govuk-table__header">@Resource.lblCropType</th>
                            <td class="govuk-table__cell">
                                @mannerEstimation.CropTypeName
                            </td>
                            <td class="govuk-table__cell"><a class="govuk-link" href="#">@Resource.lblChange</a></td>
                        </tr>

    
      
                    </tbody>
                </table>
            </govuk-tabs-item>
            @{
                int countApp = 0;
            }
            @if (applicationCount != 3)
            {
                @foreach (var item in ViewBag.MannerEstimations.MannerEstimationApplication)
                {
                    countApp++;
                    <govuk-tabs-item id="ApplicationDetail@(countApp)" label="@Resource.lblApplicationDetail">
                        <h3 class="govuk-heading-m non-standard">@Resource.lblApplicationDetails</h3>
                        @{
                            ViewBag.Count = countApp;
                        }
                        <partial name="_MannerEstimationResultApplicationTabPartial" model="@item" />
                    </govuk-tabs-item>

                }
            }
            else
            {
                <govuk-tabs-item id="ApplicationDetails" label="@Resource.lblApplicationDetails">

                    @foreach (var item in ViewBag.MannerEstimations.MannerEstimationApplication)
                    {
                        countApp++;
                        <h3 class="govuk-heading-m">@string.Format("{0} - {1}", Resource.lblApplication, countApp)</h3>
                        ViewBag.Count = countApp;

                        <partial name="_MannerEstimationResultApplicationTabPartial" model="@item" />
                        <br />
                        @if (countApp != applicationCount)
                        {
                            <hr class="margin-bottom-thirty">

                        }
                    }

                </govuk-tabs-item>

            }
        </govuk-tabs>

    </div>

</div>

    