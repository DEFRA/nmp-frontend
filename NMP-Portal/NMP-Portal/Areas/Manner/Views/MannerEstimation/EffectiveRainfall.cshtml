@using NMP.Commons.Resources
@model NMP.Commons.ViewModels.MannerEstimationStep32ViewModel
@{

    string title = Resource.lblMannerEstimate;
    ViewData["Title"] = $"{Resource.lblTotalRainfallSinceApplication} {Resource.lblHyphen} {title}";
   
}

@section BeforeContent {
    @if(Model.IsSoilDrainageEndDateChange)
    {
        <govuk-back-link asp-action="SoilDrainageEndDate" asp-controller="MannerEstimation" asp-route-sid="@ViewBag.SessionId">@Resource.lblBack</govuk-back-link>
    }
    else{
    <partial name="_BackLinkForConditionPages" model="Model" />
    }
}

<form asp-action="EffectiveRainfall" asp-controller="MannerEstimation" method="post" autocomplete="off" asp-route-sessionId="@ViewBag.SessionId">
    @Html.AntiForgeryToken()
    <div class="govuk-grid-row">

        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-l">@Resource.lblTotalRainfallSinceApplication</h1>
            <p class="govuk-body">@Resource.lblThisIsTotalRainfall</p>
            <div class="text-group margin-bottom-forty">
                <h3 class="govuk-heading-s">@Resource.lblTotalRainfall</h3>
                <p class="govuk-body">@string.Concat(Model.TotalRainfall, Resource.lblmm)</p>
                <p class="govuk-body margin-bottom-forty">
                    <a class="govuk-link" asp-action="EffectiveRainfallManual" asp-controller="MannerEstimation" asp-route-sid="@ViewBag.SessionId">@Resource.lblChange<span class="govuk-visually-hidden">@Resource.lblTotalRainfallSinceApplication</span></a>
                </p>

            </div>

            <govuk-button type="submit" class="margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>

       
            <partial name="_CancelLink" model="@Model.EncryptedMannerEstimateId" />

        </div>

    </div>
</form>