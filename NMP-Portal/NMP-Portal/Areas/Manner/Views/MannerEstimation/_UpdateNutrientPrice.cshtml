@using NMP.Commons.Resources


@{
    var updateNutrientPriceQuestion = Convert.ToInt32(ViewData["UpdateNutrientPriceQuestion"]);
    var nutrientProductPriceValue = ViewData["NutrientProductPriceValue"];
    var nutrientProductPrice = ViewData["NutrientProductPrice"];
    var nutrientProductPriceHeading = ViewData["NutrientProductPriceHeading"];
    var nutrientPriceHeading = ViewData["NutrientPriceHeading"];
    var nutrientPrice = ViewData["NutrientPrice"];
    var nutrientPriceValue = ViewData["NutrientPriceValue"];
}
@if (updateNutrientPriceQuestion == (int)NMP.Commons.Enums.UpdateNutrientPriceQuestion.UpdateByProductPrice)
{
    <govuk-input name="@nutrientProductPrice" value=@nutrientProductPriceValue type="number" step="any" input-class="govuk-input--width-5" spellcheck="false">
        <govuk-input-label>
            @nutrientProductPriceHeading
            <span class="govuk-visually-hidden"> @string.Format(Resource.lblInUnit, Resource.lblPerTonnes)</span>
        </govuk-input-label>
        <govuk-input-prefix>@Resource.lblPoundSign</govuk-input-prefix>
        <govuk-input-suffix>@Resource.lblPerTonnes.ToLower()</govuk-input-suffix>
    </govuk-input>
}
else
{
    <govuk-input name=@nutrientPrice value="@nutrientPriceValue" type="number" step="any" input-class="govuk-input--width-5" spellcheck="false">
        <govuk-input-label>
            @nutrientPriceHeading
            <span class="govuk-visually-hidden"> @string.Format(Resource.lblInUnit, Resource.lblPerKg)</span>
        </govuk-input-label>
        <govuk-input-prefix>@Resource.lblPoundSign</govuk-input-prefix>

        <govuk-input-suffix>@Resource.lblPerKg.ToLower()</govuk-input-suffix>
    </govuk-input>
}