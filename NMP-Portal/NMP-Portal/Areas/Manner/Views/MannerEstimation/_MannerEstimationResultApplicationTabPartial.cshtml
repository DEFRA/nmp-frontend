@using NMP.Commons.Resources;
@using NMP.Commons.ViewModels;
@model MannerEstimationApplicationDetailsViewModel;
@{
    var count = ViewBag.Count ?? 0;
}

    <table class="govuk-table data-table manner-answers-table margin-bottom-none">
        <tbody class="govuk-table__body">
            <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">@Resource.lblWhatTypeOfOrganicMaterialWouldYouLikeUse</th>
                <td class="govuk-table__cell">@Model.ManureType</td>
                <td class="govuk-table__cell">
                <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden">@(string.Format("{0} {1}", Resource.lblMaterialType, Resource.lblChange))</span></a>
                </td>
            </tr>
            <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">@Resource.lblWhenAreYouApplyingThisOrganicMaterial</th>
                <td class="govuk-table__cell">@Model.ApplicationDate.ToString("dd MMM yyyy")</td>
                <td class="govuk-table__cell">
                <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden">@(string.Format("{0} {1}", Resource.lblApplicationDate, Resource.lblChange))</span></a>
                </td>
            </tr>

            <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">@string.Format(Resource.lblHowAreYouApplyingTheManureType, Model.ManureType)</th>
                <td class="govuk-table__cell">

                    @Model.ApplicationMethod

                </td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden">@(string.Format("{0} {1}", string.Format(Resource.lblHowAreYouApplyingTheManureType, Model.ManureType), Resource.lblChange))</span></a>
                    
                </td>
            </tr>



            <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">@Resource.lblDoYouWantToUseTheseStandardNutrientValuesForThisOrganicMaterial</th>
                <td class="govuk-table__cell">
                    @{
                        var value = TempData[$"ApplicationDefaultValues{count}"];
                        var isTrue = value != null && bool.TryParse(value.ToString(), out var result) && result;
                    }
                    @(isTrue ? Resource.lblYes : Resource.lblNo)
                </td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden">@(string.Format("{0} {1}", Resource.lblDoYouWantToUseTheseStandardNutrientValuesForThisOrganicMaterial, Resource.lblChange))</span></a>
                </td>
            </tr>


            <tr class="govuk-table__row nutrient_list">
                <th scope="row" class="govuk-table__header">@string.Format(Resource.lblNutrientValuesForManureTypeName, Model.ManureType)</th>
                <td class="govuk-table__cell">
                @if ((Model.DryMatterPercent.HasValue) && Model.DryMatterPercent.Value > 0)
                {
                    <span class="nutrient_row">@Resource.lblDryMatterContent <span class="figure w31">@string.Format("{0}%", Model.DryMatterPercent.Value)</span></span>

                }
                @if ((Model.N.HasValue) && Model.N.Value > 0)
                {
                    <span class="nutrient_row">@Resource.lblNitrogen <span class="figure w31">@string.Format(Resource.lblValueKgPerTonne, Model.N.Value)</span></span>

                }
                @if ((Model.NH4N.HasValue) && Model.NH4N.Value > 0)
                {
                    <span class="nutrient_row">@Resource.lblAmmoniumHypenN <span class="figure w31">@string.Format(Resource.lblValueKgPerTonne, Model.NH4N.Value)</span></span>

                }
                @if (Model.UricAcid > 0)
                {
                    <span class="nutrient_row">@Resource.lblUricAcid <span class="figure w31">@string.Format(Resource.lblValueKgPerTonne, Model.UricAcid)</span></span>

                }
                @if ((Model.NO3N.HasValue) && Model.NO3N.Value > 0)
                {
                    <span class="nutrient_row">@Resource.lblNitrate <span class="figure w31">@string.Format(Resource.lblValueKgPerTonne, Model.NO3N.Value)</span></span>

                }
                @if ((Model.P2O5.HasValue) && Model.P2O5.Value > 0)
                {
                    <span class="nutrient_row">@Resource.lblPhosphateP2O5 <span class="figure w31">@string.Format(Resource.lblValueKgPerTonne, Model.P2O5.Value)</span></span>

                }
                @if ((Model.K2O.HasValue) && Model.K2O.Value > 0)
                {
                    <span class="nutrient_row">@Resource.lblPotashK2O <span class="figure w31">@string.Format(Resource.lblValueKgPerTonne, Model.K2O.Value)</span></span>

                }
                @if ((Model.SO3.HasValue) && Model.SO3.Value > 0)
                {
                    <span class="nutrient_row">@Resource.lblSulphurSO3 <span class="figure w31">@string.Format(Resource.lblValueKgPerTonne, Model.SO3.Value)</span></span>

                }
                @if ((Model.MgO.HasValue) && Model.MgO.Value > 0)
                {
                    <span class="nutrient_row">@Resource.lblMagnesiumMgO <span class="figure w31">@string.Format(Resource.lblValueKgPerTonne, Model.MgO.Value)</span></span>

                }
                </td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden"> @(string.Format("{0} {1}", string.Format(Resource.lblNutrientValuesForManureTypeName, Model.ManureType), Resource.lblChange))</span></a>
                </td>
            </tr>


            <tr class="govuk-table__row">
            <th scope="row" class="govuk-table__header">@Resource.lblHowWouldYouLikeToEnterApplicationRate</th>
                <td class="govuk-table__cell">
                @TempData[$"ApplicationRateOption{count}"]
                </td>
                <td class="govuk-table__cell">
                <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden">@(string.Format("{0} {1}", Resource.lblHowWouldYouLikeToEnterApplicationRate, Resource.lblChange))</span></a>
                </td>
            </tr>


            <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">@Resource.lblApplicationRate</th>
                <td class="govuk-table__cell">

                    @string.Format(Resource.lblYieldTonnesPerHectare, Model.ApplicationRate)

                </td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden">@(string.Format("{0} {1}", Resource.lblApplicationRate, Resource.lblChange))</span></a>
                </td>
            </tr>

            <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">@string.Format(Resource.lblWhatIsTheIncorporationMethod, Model.ManureType)</th>
                <td class="govuk-table__cell">

                    @Model.IncorporationMethod

                </td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden">@(string.Format("{0} {1}", string.Format(Resource.lblWhatIsTheIncorporationMethod, Model.ManureType), Resource.lblChange))</span></a>
                </td>
            </tr>

            <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">@Resource.lblHowManyDaysWillThereBeBeforeTheManureIsIncorporated</th>
                <td class="govuk-table__cell">

                    @Model.IncorporationDelay

                </td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden">@(string.Format("{0} {1}", Resource.lblHowManyDaysWillThereBeBeforeTheManureIsIncorporated, Resource.lblChange))</span></a>
                </td>
            </tr>


            <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">@Resource.lblAutumnCropNitrogenNUptake</th>
                <td class="govuk-table__cell">@string.Format(Resource.lblAutumnCropNitrogenPerHectare, Model.AutumnCropNitrogenUptake)</td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden">@(string.Format("{0} {1}", Resource.lblAutumnCropNitrogenNUptake, Resource.lblChange))</span></a>
                </td>
            </tr>


            <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">@Resource.lblEndOfSoilDrainage</th>
                <td class="govuk-table__cell">@Model.EndOfDrainageDate.Value.ToString("d MMM yyyy")</td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden"> @(string.Format("{0} {1}", Resource.lblEndOfSoilDrainage, Resource.lblChange))</span></a>
                </td>
            </tr>


            <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">@Resource.lblRainfallWithin6HoursOfApplication</th>
                <td class="govuk-table__cell">@Model.RainType</td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden">@(string.Format("{0} {1}", Resource.lblRainfallWithin6HoursOfApplication, Resource.lblChange))</span></a>
                </td>
            </tr>


            <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">@Resource.lblTotalRainfallSinceApplication</th>
                <td class="govuk-table__cell">@string.Format(Resource.lblRainfallMM, Model.RainfallPostApplication)</td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden">@(string.Format("{0} {1}", Resource.lblTotalRainfallSinceApplication, Resource.lblChange))</span></a>
                </td>
            </tr>


            <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">@Resource.lblWindspeedAtApplication</th>
                <td class="govuk-table__cell">@Model.Windspeed</td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden">@(string.Format("{0} {1}", Resource.lblWindspeedAtApplication, Resource.lblChange))</span></a>
                </td>
            </tr>


            <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__header">@Resource.lblTopsoilMoisture</th>
            <td class="govuk-table__cell">@Model.MoistureType</td>
                <td class="govuk-table__cell">
                    <a class="govuk-link" href="#">@Resource.lblChange<span class="govuk-visually-hidden">@(string.Format("{0} {1}", Resource.lblTopsoilMoisture, Resource.lblChange))</span></a>
                </td>
            </tr>


        </tbody>
    </table>
