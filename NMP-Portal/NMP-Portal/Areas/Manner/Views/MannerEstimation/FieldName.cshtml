@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep5ViewModel

@{
    string title = Resource.lblMannerEstimate;
    ViewData["Title"] = $"{Resource.lblWhatIsTheFarmName} {Resource.lblHyphen} {title}";
    ViewBag.CurrentStep = (int)MannerEstimateWizardSteps.FarmName;
    var backAction = (!string.IsNullOrWhiteSpace(Model.EncryptedMannerEstimateId)) ? "MannerEstimationResult" : "IsFarmOrganic";
    @if(Model.MannerFarmId!=null)
    {
        backAction = "Name";
    }
}

@section BeforeContent {
    <govuk-back-link asp-action="@backAction" asp-controller="MannerEstimation" asp-route-q="@(backAction == "MannerEstimationResult" ? Model.EncryptedMannerEstimateId : null)">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="FieldName" method="post" asp-controller="MannerEstimation" autocomplete="off">
            @Html.AntiForgeryToken()
            <govuk-input for="@Model.FieldName">
                <govuk-input-label is-page-heading="true" class="govuk-label--l">
                    @Resource.AddFieldNameQuestion
                </govuk-input-label>
            </govuk-input>
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button> 
        </form>
        <partial name="_CancelLink" model="@Model.EncryptedMannerEstimateId" />
</div>
</div>