@using NMP.Commons.Resources
@model NMP.Commons.ViewModels.MannerEstimationStep23ViewModel
@{
    string title = Resource.lblMannerEstimate;
    string heading = string.Format(Resource.lblHowAreYouApplyingTheManureType, (Model.ManureTypeId == (int)NMP.Commons.Enums.ManureTypes.OtherSolidMaterials || Model.ManureTypeId == (int)NMP.Commons.Enums.ManureTypes.OtherLiquidMaterials) ? Model.OtherMaterialName : Model.ManureTypeName);
    ViewData["Title"] = $"{heading} {Resource.lblHyphen} {title}";
    var backAction = "ApplicationDate";
    if (!string.IsNullOrWhiteSpace(Model.EncryptedMannerEstimateId) && !Model.IsManureTypeChange&&!Model.IsComingForAddNewApplication)
    {
        backAction = "MannerEstimationResult";
    }
}
@section BeforeContent {
    <govuk-back-link asp-action="@backAction" asp-controller="MannerEstimation" asp-route-q="@(backAction == "MannerEstimationResult" ? Model.EncryptedMannerEstimateId : null)">@Resource.lblBack</govuk-back-link>

}


<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

        @if (TempData["ApplicationMethodError"] != null)
        {
            <govuk-error-summary>
                <govuk-error-summary-item href="#">@TempData["ApplicationMethodError"]</govuk-error-summary-item>
            </govuk-error-summary>
        }
        <form asp-action="ApplicationMethod" asp-controller="MannerEstimation" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
           
            <govuk-radios for="@Model.ApplicationMethodId">
                <govuk-radios-fieldset>

                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @heading
                    </govuk-radios-fieldset-legend>
                    <govuk-radios-hint>
                        @Resource.lblSelectOneOption                        
                    </govuk-radios-hint>
                    @if (ViewBag.ApplicationMethodList != null && ViewBag.ApplicationMethodList.Count > 0)
                    {
                        @foreach (var applicationMethod in ViewBag.ApplicationMethodList)
                        {
                            <govuk-radios-item value="@applicationMethod.ID">@applicationMethod.Name</govuk-radios-item>
                        }
                    }
                </govuk-radios-fieldset>
            </govuk-radios>
            <govuk-button type="submit" class="margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>

           
            <partial name="_CancelLink" model="@Model.EncryptedMannerEstimateId" />
        </form>
    </div>

</div>
