@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep18ViewModel

@{
    string title = Resource.lblMannerEstimate;
    string heading = string.Format(Resource.lblWhatIsTheTopSoilInFieldName, Model.FieldName);
    ViewData["Title"] = $"{heading} {Resource.lblHyphen} {title}";
}

@section BeforeContent {
    <govuk-back-link asp-action="@(Model.IsCheckAnswer ? "CheckAnswer" : "NVZField")" asp-controller="MannerEstimation">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="TopSoil" method="post" asp-controller="MannerEstimation" autocomplete="off">
            @Html.AntiForgeryToken()
            <govuk-radios for="@Model.TopSoilId">
                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @heading
                    </govuk-radios-fieldset-legend>
                    <govuk-radios-hint>@Resource.lblSelectOneOption</govuk-radios-hint>
                    @if (ViewBag.TopsoilList != null)
                    {
                        @foreach (var item in ViewBag.TopSoilList ?? Enumerable.Empty<dynamic>())
                        {
                            <govuk-radios-item value="@item.Value">
                                @item.Text
                            </govuk-radios-item>
                        }
                    }
                </govuk-radios-fieldset>
            </govuk-radios>

            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>

        <partial name="_CancelLink" model="@Model.IsCheckAnswer" />
    </div>
</div>