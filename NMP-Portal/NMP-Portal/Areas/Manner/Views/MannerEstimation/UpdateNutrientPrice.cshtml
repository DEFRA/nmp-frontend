@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep34ViewModel

@{
    ViewData["Title"] = $"{Resource.lblUpdateNitrogenPrices} {Resource.lblHyphen} {Resource.lblMannerEstimate}";

}

@section BeforeContent {
    <govuk-back-link asp-action="MannerEstimationResult" asp-controller="MannerEstimation" asp-route-q="@Model.EncryptedMannerEstimateId">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="UpdateNutrientPrice" method="post" asp-controller="MannerEstimation" autocomplete="off">
            @Html.AntiForgeryToken()
            <h2 class="govuk-heading-m">@Resource.lblUpdateNitrogenPrices</h2>
            @if (Model.UpdateNutrientPriceQuestion == (int)NMP.Commons.Enums.UpdateNutrientPriceQuestion.UpdateByNutrientPrice)
            {
                <govuk-input name="NitrogenProductPrice" for=@Model.NitrogenProductPrice type="number" step="any" input-class="govuk-input--width-5" spellcheck="false">
                    <govuk-input-label>
                        @Resource.lblWhatIsTheNitrogenPrice
                        <govuk-input-suffix>@Resource.lblPoundSign</govuk-input-suffix>
                        <span class="govuk-visually-hidden"> @string.Format(Resource.lblInUnit, Resource.lblPerTonnes)</span>
                    </govuk-input-label>

                    <govuk-input-suffix>@Resource.lblPerTonnes.ToLower()</govuk-input-suffix>
                </govuk-input>
            }
            else
            {
                <govuk-input name="NitrogenPrice" for=@Model.NitrogenPrice type="number" step="any" input-class="govuk-input--width-5" spellcheck="false">
                    <govuk-input-label>
                        @Resource.lblWhatIstheNitratePrice
                        <govuk-input-suffix>@Resource.lblPoundSign</govuk-input-suffix>
                        <span class="govuk-visually-hidden"> @string.Format(Resource.lblInUnit, Resource.lblPerTonnes)</span>
                    </govuk-input-label>

                    <govuk-input-suffix>@Resource.lblHectares.ToLower()</govuk-input-suffix>
                </govuk-input>
            }
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>
        <p class="govuk-body cancel-link">
            <a class="govuk-link" asp-action="MannerEstimationResult" asp-controller="MannerEstimation" asp-route-q="@Model.EncryptedMannerEstimateId">@Resource.lblCancel</a>

        </p>
    </div>
</div>