
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep15ViewModel

@{
    string title = Resource.lblMannerEstimate;
    ViewData["Title"] = $"{Resource.lblWhichFarmWouldYouLikeToUse} {Resource.lblHyphen} {title}";
    ViewBag.IsCheckAnswer = Model.IsCheckAnswer;
}
@section BeforeContent {
    <govuk-back-link asp-action="@(Model.IsCheckAnswer ? "CheckAnswer" : "CopyExistingFarmAndFieldDetails")" asp-controller="MannerEstimation">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="FarmToCopy" method="post" asp-controller="MannerEstimation" autocomplete="off">
            @Html.AntiForgeryToken()
            <govuk-radios for="@Model.FarmId">
                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @Resource.lblWhichFarmWouldYouLikeToUse
                    </govuk-radios-fieldset-legend>
                    
                    @if (ViewBag.FarmList != null)
                    {
                        @foreach (var item in ViewBag.FarmList)
                        {
                            <govuk-radios-item value="@item.Value">@item.Text</govuk-radios-item>
                        }
                    }
                </govuk-radios-fieldset>
            </govuk-radios>
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
           
        </form>
        <partial name="_CancelLink" />
    </div>
</div>
