@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep37ViewModel

@{
    ViewData["Title"] = $"{string.Format(Resource.lblUpdateNutrientPrices, Resource.lblPhosphateP2O5Lowercase)} {Resource.lblHyphen} {Resource.lblMannerEstimate}";
    string suffix = string.Empty;
    string appendLabel = string.Empty;
    bool isProductPrice = Model.UpdatePhosphorusPriceQuestion == (int)UpdateNutrientPriceQuestion.UpdateByProductPrice;
    if(isProductPrice)
    {
        appendLabel=string.Format(Resource.lblInUnit, Resource.lblPerTonnes);
        suffix = Resource.lblPerTonnes.ToLower();
    }
    else
    {
        appendLabel=string.Format(Resource.lblInUnit, Resource.lblPerKg);
        suffix = Resource.lblPerKg.ToLower();
    }
    string preffix=Resource.lblPoundSign;

}

@section BeforeContent {
    <govuk-back-link asp-action="UpdatePhosphorusPriceQuestion" asp-controller="MannerEstimation" asp-route-sid="@ViewBag.SessionId" asp-route-q="@Model.EncryptedMannerEstimateId">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        @if (TempData["PhosphorusPriceError"] != null)
        {
            <govuk-error-summary>
                <govuk-error-summary-item href="#">@TempData["PhosphorusPriceError"]</govuk-error-summary-item>
            </govuk-error-summary>
        }
        <form asp-action="UpdatePhosphorusPrice" method="post" asp-controller="MannerEstimation" autocomplete="off" asp-route-sessionId="@ViewBag.SessionId">
            @Html.AntiForgeryToken()
            <h2 class="govuk-heading-m">@string.Format(Resource.lblUpdateNutrientPrices, Resource.lblPhosphateP2O5Lowercase)</h2>
            @if (Model.UpdatePhosphorusPriceQuestion == (int)NMP.Commons.Enums.UpdateNutrientPriceQuestion.UpdateByProductPrice)
            {
                <govuk-input name="PhosphorusProductPrice" for=@Model.PhosphorusProductPrice type="number" step="any" input-class="govuk-input--width-5" spellcheck="false">
                    <govuk-input-label>
                        @string.Format(Resource.lblWhatIstheNutrientPrice,Model.NutrientProductName.ToLower())
                        <span class="govuk-visually-hidden"> @appendLabel</span>
                    </govuk-input-label>
                    <govuk-input-prefix>@preffix</govuk-input-prefix>
                    <govuk-input-suffix>@suffix</govuk-input-suffix>
                </govuk-input>
            }
            else
            {
                <govuk-input name="PhosphorusPrice" for=@Model.PhosphorusPrice type="number" step="any" input-class="govuk-input--width-5" spellcheck="false">
                    <govuk-input-label>
                        @string.Format(Resource.lblWhatIstheNutrientPrice, Resource.lblPhosphateP2O5Lowercase)
                        <span class="govuk-visually-hidden"> @appendLabel</span>
                    </govuk-input-label>
                    <govuk-input-prefix>@preffix</govuk-input-prefix>

                    <govuk-input-suffix>@suffix</govuk-input-suffix>
                </govuk-input>
            }
          
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>
        <p class="govuk-body cancel-link">
            <a class="govuk-link" asp-action="MannerEstimationResult" asp-controller="MannerEstimation" asp-route-q="@Model.EncryptedMannerEstimateId">@Resource.lblCancel</a>

        </p>
    </div>
</div>