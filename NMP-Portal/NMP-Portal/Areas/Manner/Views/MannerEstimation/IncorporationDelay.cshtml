@using NMP.Commons.Resources
@model NMP.Commons.ViewModels.MannerEstimationStep30ViewModel
@{
    bool isOtherManure = (Model.ManureTypeId == (int)NMP.Commons.Enums.ManureTypes.OtherSolidMaterials || Model.ManureTypeId == (int)NMP.Commons.Enums.ManureTypes.OtherLiquidMaterials);

    ViewData["Title"] = $"{string.Format(Resource.lblHowLongIsTheGapBetweenApplicationAndIncoporation, isOtherManure ? Model.OtherMaterialName : Model.ManureTypeName)} {Resource.lblHyphen} {Resource.lblMannerEstimate}";
    
    var backAction = "IncorporationMethod";
    if (!string.IsNullOrWhiteSpace(Model.EncryptedMannerEstimateId) && !Model.IsManureTypeChange && !Model.IsIncorporationMethodChange)
    {
        backAction = "MannerEstimationResult";
    }
}
@section BeforeContent {
    <govuk-back-link asp-action="@backAction" asp-controller="MannerEstimation" asp-route-q="@(backAction == "MannerEstimationResult" ? Model.EncryptedMannerEstimateId : null)">@Resource.lblBack</govuk-back-link>

}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="IncorporationDelay" asp-controller="MannerEstimation" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            @if (TempData["IncorporationDelayError"] != null)
            {
                <govuk-error-summary>
                    <govuk-error-summary-item>@TempData["IncorporationDelayError"]</govuk-error-summary-item>
                </govuk-error-summary>
            }
            <govuk-radios for="@Model.IncorporationDelayId">
                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @string.Format(Resource.lblHowLongIsTheGapBetweenApplicationAndIncoporation, isOtherManure ? Model.OtherMaterialName : Model.ManureTypeName)
                    </govuk-radios-fieldset-legend>
                    <govuk-radios-hint>
                        @Resource.lblSelectOneOption
                    </govuk-radios-hint>
                    @if (ViewBag.IncorporationDelaysList != null && ViewBag.IncorporationDelaysList.Count > 0)
                    {
                        @foreach (var item in ViewBag.IncorporationDelaysList)
                        {
                            <govuk-radios-item value="@item.ID">@item.Name</govuk-radios-item>
                        }

                    }

                </govuk-radios-fieldset>
            </govuk-radios>

            <govuk-button type="submit" class="margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
            <partial name="_CancelLink" model="@Model.EncryptedMannerEstimateId" />
        </form>
    </div>

</div>

