@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep35ViewModel

@{
    string header = Resource.lblWhichNutrientProductWouldYouLikeToUse;
    ViewData["Title"] = $"{header} {Resource.lblHyphen} {Resource.lblMannerEstimate}";
}

@section BeforeContent {
    <govuk-back-link asp-action="MannerEstimationResult" asp-controller="MannerEstimation" asp-route-sid="@ViewBag.SessionId" asp-route-q="@Model.EncryptedMannerEstimateId">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        @if (TempData["NutrientProductError"] != null)
        {
            <govuk-error-summary>
                <govuk-error-summary-item href="#">@TempData["NutrientProductError"]</govuk-error-summary-item>
            </govuk-error-summary>
        }
        <form asp-action="NutrientProduct" method="post" asp-controller="MannerEstimation" autocomplete="off" asp-route-sessionId="@ViewBag.SessionId">
            @Html.AntiForgeryToken()
            <govuk-radios class="govuk-radios--inline" for="@Model.NutrientProductId">
                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @header
                    </govuk-radios-fieldset-legend>
                    @foreach (var item in ViewBag.NutrientProductList ?? Enumerable.Empty<dynamic>())
                    {
                        <govuk-radios-item value="@item.Value">
                            @item.Text
                            <govuk-radios-item-hint>
                                @item.Hint
                            </govuk-radios-item-hint>
                        </govuk-radios-item>
                    }
                </govuk-radios-fieldset>
            </govuk-radios>
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>
        <p class="govuk-body cancel-link">
            <a class="govuk-link" asp-action="MannerEstimationResult" asp-controller="MannerEstimation" asp-route-q="@Model.EncryptedMannerEstimateId">@Resource.lblCancel</a>
        </p>
    </div>
</div>