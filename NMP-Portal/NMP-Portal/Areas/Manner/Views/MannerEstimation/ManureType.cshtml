@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep12ViewModel

@{
    string title = Resource.lblMannerEstimate;
    string heading = Resource.lblWhatTypeOfOrganicMaterialAreYouUsing;
    if (Model.ManureGroupId != (int)NMP.Commons.Enums.ManureGroup.AnotherTypeOfOrganicMaterial)
    {
        heading = string.Format(Resource.lblWhatTypeOfManureGroupAreYouUsingInThisApplication, Model.ManureGroupName);
    }
    ViewData["Title"] = $"{heading} {Resource.lblHyphen} {title}";
    
    var backAction = !string.IsNullOrWhiteSpace(Model.EncryptedMannerEstimateId) && !Model.IsComingForAddNewApplication && !Model.IsManureGroupIdChange ? "MannerEstimationResult" : "ManureGroup";
}
@section BeforeContent {
    <govuk-back-link asp-action="@backAction" asp-controller="MannerEstimation" asp-route-sid="@ViewBag.SessionId" asp-route-q="@(backAction == "MannerEstimationResult" ? Model.EncryptedMannerEstimateId : null)">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="ManureType" method="post" asp-controller="MannerEstimation" autocomplete="off" asp-route-sessionId="@ViewBag.SessionId">
            @Html.AntiForgeryToken()
            <govuk-radios for="@Model.ManureTypeId">
                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @heading
                    </govuk-radios-fieldset-legend>
                    <govuk-radios-hint>
                        @Resource.lblSelectOneOption
                    </govuk-radios-hint>

                    @foreach (var item in ViewBag.ManureTypeList)
                    {
                        <govuk-radios-item value="@item.Value">@item.Text</govuk-radios-item>
                    }
                </govuk-radios-fieldset>
            </govuk-radios>

             <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>

        <partial name="_CancelLink" model="@Model.EncryptedMannerEstimateId" />
    </div>
</div>