@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep12ViewModel

@{
    string title = Resource.lblMannerEstimate;
    string heading =Resource.lblWhatTypeOfLivestockManureAreYouUsingInThisApplication;
    ViewData["Title"] = $"{heading} {Resource.lblHyphen} {title}";
}
@section BeforeContent {
    <govuk-back-link asp-action="@(!string.IsNullOrWhiteSpace(Model.EncryptedMannerEstimateId) ? "MannerEstimationResult" : "ManureGroup")" asp-controller="MannerEstimation" asp-route-q="@Model.EncryptedMannerEstimateId">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="ManureType" method="post" asp-controller="MannerEstimation" autocomplete="off">
            @Html.AntiForgeryToken()
            <govuk-radios for="@Model.ManureTypeId">
                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @heading
                    </govuk-radios-fieldset-legend>
                    <govuk-radios-hint>
                        @Resource.lblSelectOneOptionTheseOptionsComeFromAHDB
                    </govuk-radios-hint>

                    @foreach (var item in ViewBag.ManureTypeList)
                    {
                        <govuk-radios-item value="@item.Value">@item.Text</govuk-radios-item>
                    }
                </govuk-radios-fieldset>
            </govuk-radios>

             <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>

        <partial name="_CancelLink" model="@Model.EncryptedMannerEstimateId" />
    </div>
</div>