@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep3ViewModel

@{
    string title = Resource.lblMannerEstimate;
    ViewData["Title"] = $"{string.Format(Resource.lblWhatIsPostcode, Model.FarmName)} {Resource.lblHyphen} {title}";
    ViewBag.CurrentStep = (int)MannerEstimateWizardSteps.Postcode;
}

@section BeforeContent {
    <govuk-back-link asp-action="@((!string.IsNullOrWhiteSpace(Model.EncryptedMannerEstimateId) && (!Model.IsCountryIdChange)) ? "MannerEstimationResult" : "Country")" asp-controller="MannerEstimation" asp-route-q="@Model.EncryptedMannerEstimateId">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="PostCode" method="post" asp-controller="MannerEstimation" autocomplete="on">
            @Html.AntiForgeryToken()
            <govuk-input input-class="govuk-input--width-5" for="@Model.Postcode">
                <govuk-input-label is-page-heading="true" class="govuk-label--l ">@string.Format(Resource.lblWhatIsPostcode, Model.FarmName)</govuk-input-label>
            </govuk-input>
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button  margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>

        <partial name="_CancelLink" model="@Model.EncryptedMannerEstimateId" />
    </div>
</div>