@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep13ViewModel

@{
    string title = Resource.lblMannerEstimate;
    string heading = !string.IsNullOrWhiteSpace(Model.EncryptedSoilOrCropTypeChangeCounter) ? string.Format(Resource.lblWHenAreYouApplyingManureOnThisFieldForApplicationNumber, Model.ManureTypeName, Model.FieldName, Model.ApplicationNo) : string.Format(Resource.lblWhenAreYouApplyingManureOnThisField, Model.ManureTypeName, Model.FieldName);

    ViewData["Title"] = $"{heading} {Resource.lblHyphen} {title}";
}

@section BeforeContent {
    @if (!string.IsNullOrWhiteSpace(Model.EncryptedSoilOrCropTypeChangeCounter) && Model.ApplicationNo == 1)
    {
        @if (Model.IsCropTypeChange)
        {
            if (Model.IsSowingDateAction)
            {
                <govuk-back-link asp-action="SowingDate" asp-controller="MannerEstimation" asp-route-sid="@ViewBag.SessionId">@Resource.lblBack</govuk-back-link>
            }
            else
            {
                <govuk-back-link asp-action="CropType" asp-controller="MannerEstimation" asp-route-sid="@ViewBag.SessionId">@Resource.lblBack</govuk-back-link>
            }
        }
        else
        {
            <govuk-back-link asp-action="SubSoil" asp-controller="MannerEstimation" asp-route-sid="@ViewBag.SessionId">@Resource.lblBack</govuk-back-link>
        }
    }
    else
    {
        <govuk-back-link asp-action="BackRedirectActionForApplicationDate" asp-controller="MannerEstimation" asp-route-sid="@ViewBag.SessionId">@Resource.lblBack</govuk-back-link>

    }
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        @if (TempData["ApplicationDateError"] != null)
        {
            <govuk-error-summary>
                <govuk-error-summary-item href="#">@TempData["ApplicationDateError"]</govuk-error-summary-item>
            </govuk-error-summary>
        }
        <form asp-action="ApplicationDate" method="post" asp-controller="MannerEstimation" autocomplete="off" asp-route-sessionId="@ViewBag.SessionId">
            @Html.AntiForgeryToken()

            @await Html.PartialAsync("_MannerApplicationDateWarning", Model)
            <govuk-date-input for="ApplicationDate">
                <govuk-date-input-fieldset>
                    <govuk-date-input-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @heading
                    </govuk-date-input-fieldset-legend>
                    <govuk-date-input-hint>

                        @if (Model.ClosedPeriod != null)
                        {
                            <p class="govuk-body">@Resource.lblYourClosedPeriodForSpreadingOrganicMaterials</p>
                            <p class="govuk-body">
                                <strong>@Model.ClosedPeriod</strong><br />
                                @Resource.lblBasedOnYourCropSoilTypeFarmDetails
                            </p>
                        }
                        <p class="govuk-body">
                            @Resource.MsgManureApplyingDateDontHaveExactDate
                        </p>
                        @string.Format(Resource.lblSampleDate, DateTime.Now.Year - 1)
                    </govuk-date-input-hint>

                    <govuk-date-input-day maxlength="2" pattern="[0-9]*" autocomplete="off"></govuk-date-input-day>
                    <govuk-date-input-month maxlength="2" pattern="[0-9]*" autocomplete="off"></govuk-date-input-month>
                    <govuk-date-input-year maxlength="4" pattern="[0-9]*" autocomplete="off"></govuk-date-input-year>
                </govuk-date-input-fieldset>
            </govuk-date-input>
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>

        <partial name="_CancelLink" model="@Model.EncryptedMannerEstimateId" />
    </div>
</div>