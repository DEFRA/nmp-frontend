@using NMP.Commons.Resources
@model NMP.Commons.ViewModels.MannerEstimationStep32ViewModel
@{

    string title = Resource.lblMannerEstimate;
    ViewData["Title"] = $"{Resource.lblHowWetWasTheTopsoil} {Resource.lblHyphen} {title}";
    
}
@section BeforeContent {
    <partial name="_BackLinkForConditionPages" model="Model" />
}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        @if (ViewBag.Error != null)
        {
            <govuk-error-summary>
                <govuk-error-summary-item href="#">@ViewBag.Error</govuk-error-summary-item>
            </govuk-error-summary>
        }
        <form asp-action="TopsoilMoisture" asp-controller="MannerEstimation" method="post" autocomplete="off" asp-route-sessionId="@ViewBag.SessionId">
            @Html.AntiForgeryToken()
            <govuk-radios for="@Model.MoistureTypeId">
                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @Resource.lblHowWetWasTheTopsoil
                    </govuk-radios-fieldset-legend>
                    <govuk-radios-hint>
                        @Resource.lblSelectOneOption                        
                    </govuk-radios-hint>
                    @if (ViewBag.MoisterTypes != null && ViewBag.MoisterTypes.Count > 0)
                    {
                        @foreach (var item in ViewBag.MoisterTypes)
                        {
                            <govuk-radios-item value="@item.ID">@item.Name</govuk-radios-item>
                        }
                    }
                </govuk-radios-fieldset>
            </govuk-radios>
            <govuk-button type="submit" class="margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>

            <partial name="_CancelLink" model="@Model.EncryptedMannerEstimateId" />
        </form>
    </div>
</div>