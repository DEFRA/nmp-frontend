@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep33ViewModel

@{
    ViewData["Title"] = $"{string.Format(Resource.lblHowWouldYouLikeToUpdateYourNutrientPrice, Resource.lblNitrogenLowercase)} {Resource.lblHyphen} {Resource.lblMannerEstimate}";

}

@section BeforeContent {
    <govuk-back-link asp-action="NutrientProduct" asp-controller="MannerEstimation" asp-route-q="@Model.EncryptedMannerEstimateId">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="UpdateNitrogenPriceQuestion" method="post" asp-controller="MannerEstimation" autocomplete="off">
            @Html.AntiForgeryToken()
            @{
                var viewData = new ViewDataDictionary(ViewData);
                viewData["PropertyName"] = nameof(Model.UpdateNitrogenPriceQuestion);
                viewData["PropertyValue"] = Model.UpdateNitrogenPriceQuestion;
                viewData["Legend"] = string.Format(Resource.lblHowWouldYouLikeToUpdateYourNutrientPrice, Resource.lblNitrogenLowercase);
                viewData["IsNutrientDefaultProduct"] = ViewBag.isNutrientDefaultProduct;
            }

            @await Html.PartialAsync("_UpdateNutrientPriceQuestion", viewData)
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>
        <p class="govuk-body cancel-link">
            <a class="govuk-link" asp-action="MannerEstimationResult" asp-controller="MannerEstimation" asp-route-q="@Model.EncryptedMannerEstimateId">@Resource.lblCancel</a>
        </p>
    </div>
</div>