@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep8ViewModel

@{
    string title = Resource.lblMannerEstimate;
    string heading = string.Format(Resource.lblWhatCropAreYouApplyingThisOrganicMaterial, Resource.lblCropGroup.ToLower());
    ViewData["Title"] = $"{heading} {Resource.lblHyphen} {title}";
    string backAction = "SubSoil";
    if (!string.IsNullOrWhiteSpace(Model.EncryptedMannerEstimateId))
    {
        backAction = "MannerEstimationResult";
    }
    else if (Model.IsFarmCopied)
    {
        backAction = "FieldToCopy";
    }
}

@section BeforeContent {
    <govuk-back-link asp-action="@backAction" asp-controller="MannerEstimation" asp-route-sid="@ViewBag.SessionId" asp-route-q="@(backAction == "MannerEstimationResult" ? Model.EncryptedMannerEstimateId : null)">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="CropGroup" method="post" asp-controller="MannerEstimation" autocomplete="off" asp-route-sessionId="@ViewBag.SessionId">
            @Html.AntiForgeryToken()
            <govuk-radios for="@Model.CropGroupId">
                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @heading
                    </govuk-radios-fieldset-legend>
                    <govuk-radios-hint>
                        @Resource.lblSelectOneOptionTheseOptionsComeFromAHDB
                    </govuk-radios-hint>

                    @foreach (var item in ViewBag.CropGroupList ?? Enumerable.Empty<dynamic>())
                    {
                        <govuk-radios-item value="@item.CropGroupId">
                            @item.CropGroupName
                        </govuk-radios-item>
                    }
                </govuk-radios-fieldset>
            </govuk-radios>

            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>

        <partial name="_CancelLink" model="@Model.EncryptedMannerEstimateId" />
    </div>
</div>