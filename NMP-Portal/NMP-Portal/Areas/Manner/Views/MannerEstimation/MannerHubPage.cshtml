@using NMP.Commons.Resources;
@using NMP.Commons.ViewModels;

@{
    ViewData["Title"] = Resource.lblMannerHubPage;
}
@section BeforeContent {
    <govuk-back-link asp-action="MannerFarmList" asp-controller="MannerEstimation" asp-area="Manner">@Resource.lblBack</govuk-back-link>
}

@if (TempData["Error"] != null)
{
    <govuk-error-summary>
        <govuk-error-summary-item href="#">@TempData["Error"]</govuk-error-summary-item>
    </govuk-error-summary>
}
else
{
    <div class="govuk-grid-row">
        <div id="all-plans-table" class="govuk-grid-column-full">

            @if (ViewBag.Success != null && ViewBag.Success == "true")
            {
                @if (ViewBag.SuccessForCopyEstimate != null)
                {
                    <govuk-notification-banner type="NotificationBannerType.Success">
                        <h3 class="govuk-notification-banner__heading">
                            @Resource.lblCopyOfNutrientSupplyEstimateCreated
                        </h3>
                        <p class="govuk-body">@Resource.lblSelectViewOrChangeToEditThisEstimateOrToViewTheResults</p>
                    </govuk-notification-banner>
                }
                else{
                <govuk-notification-banner type="NotificationBannerType.Success">
                    <h3 class="govuk-notification-banner__heading">
                        @Resource.lblNutrientSupplyEstimatesRemoved
                    </h3>

                </govuk-notification-banner>
                }
            }

            <h1 class="govuk-heading-l">@string.Format(Resource.lblNutrientSupplyEstimatesForFarmName, ViewBag.MannerFarmName) </h1>

            <form asp-action="Name" method="get" asp-controller="MannerEstimation" autocomplete="off">
                <govuk-button type="submit">
                    @Resource.lblCreateANewSupplyEstimateForThisFarm
                </govuk-button>
            </form>

             @if (ViewBag.MannerEstimations != null && ViewBag.MannerEstimations.Count > 0)
            { 
                <p class="govuk-body margin-bottom-thirty">@Resource.lblYouCanAlso <a asp-action="RemoveEstimations" asp-route-q="@ViewBag.EncryptedMannerFarmId">@Resource.lblRemoveANutrientSupplyEstimate</a></p>
             } 

            <h2 class="govuk-heading-m">@Resource.lblNutrientSupplyEstimates</h2>

            <table class="govuk-table data-table">
                <thead class="govuk-table__head">
                    <tr class="govuk-table__row">
                        <th scope="col" class="govuk-table__header">@Resource.lblReference</th>
                        <th scope="col" class="govuk-table__header">@Resource.lblFarm</th>
                        <th scope="col" class="govuk-table__header">@Resource.lblField</th>
                        <th scope="col" class="govuk-table__header">@Resource.lblLastUpdate</th>
                        <th scope="col" class="govuk-table__header"><span class="govuk-visually-hidden">@Resource.lblUpdateOrMakeACopy</span></th>
                    </tr>
                </thead>
                <tbody class="govuk-table__body">
                    @if (ViewBag.MannerEstimations != null && ViewBag.MannerEstimations.Count > 0)
                    {
                        @foreach (var estimation in ViewBag.MannerEstimations)
                        {
                            <tr class="govuk-table__row">
                                <td class="govuk-table__cell">@estimation.Name</td>
                                <td class="govuk-table__cell">@estimation.FarmName</td>
                                <td class="govuk-table__cell">@estimation.FieldName</td>
                                <td class="govuk-table__cell">@(estimation.ModifiedOn == null ? estimation.CreatedOn.ToString("dd MMMM yyyy") : estimation.ModifiedOn.ToString("dd MMMM yyyy"))</td>
                                <td class="govuk-table__cell"><a asp-action="MannerEstimationResult" asp-controller="MannerEstimation" asp-route-q="@estimation.EncryptedId" aria-label="@(string.Format("{0} {1}", Resource.lblUpdateOrMakeACopy, string.Format(Resource.MsgGenericFor, estimation.FarmName)))">@Resource.lblViewOrChange</a></td>
                            </tr>
                        }
                    }
                    @if (ViewBag.MannerEstimations == null || ViewBag.MannerEstimations.Count == 0)
                    {
                        <tr class="govuk-table__row">
                            <td class="govuk-table__cell" colspan="5">@Resource.lblYouHaveNoNutrientSupplyEstimates</td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>





}
