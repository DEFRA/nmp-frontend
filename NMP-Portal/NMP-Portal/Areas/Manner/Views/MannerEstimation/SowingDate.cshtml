@using NMP.Commons.Resources
@model NMP.Commons.ViewModels.MannerEstimationStep20ViewModel
@{
    string pageHeading = string.Format(Resource.lblWhatIsThePlantingDate, Model.CropTypeName, Model.FieldName);

    ViewData["Title"] = $"{pageHeading} {Resource.lblHyphen} {Resource.lblMannerEstimate}";
    var backAction = (!string.IsNullOrWhiteSpace(Model.EncryptedMannerEstimateId)&&!Model.IsCropTypeChange) ? "MannerEstimationResult" : "CropType";
}

@section BeforeContent {
    <govuk-back-link asp-action="@backAction" asp-controller="MannerEstimation" asp-route-sid="@ViewBag.SessionId" asp-route-q="@(backAction == "MannerEstimationResult" ? Model.EncryptedMannerEstimateId : null)">@Resource.lblBack</govuk-back-link>
}
<form asp-action="SowingDate" asp-controller="MannerEstimation" method="post" autocomplete="off" asp-route-sessionId="@ViewBag.SessionId">
    @Html.AntiForgeryToken()
    @if (TempData["SowingDateError"] != null)
    {
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-two-thirds">
                <govuk-error-summary>
                    <govuk-error-summary-item href="#">@TempData["SowingDateError"]</govuk-error-summary-item>
                </govuk-error-summary>
            </div>
        </div>
    }
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">

            <govuk-date-input for="@Model.SowingDate">
                <govuk-date-input-fieldset>
                    <govuk-date-input-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @pageHeading
                    </govuk-date-input-fieldset-legend>
                    <govuk-date-input-hint>
                        @string.Format(Resource.MsgDateExample, DateTime.Now.Year - 1)
                    </govuk-date-input-hint>
                    <govuk-date-input-day maxlength="2" pattern="[0-9]*"></govuk-date-input-day>
                    <govuk-date-input-month maxlength="2" pattern="[0-9]*"></govuk-date-input-month>
                    <govuk-date-input-year maxlength="4" pattern="[0-9]*"></govuk-date-input-year>
                </govuk-date-input-fieldset>
            </govuk-date-input>

                  
            <govuk-button type="submit" class="margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
            <partial name="_CancelLink" model="@Model.EncryptedMannerEstimateId" />
        </div>

    </div>
</form>