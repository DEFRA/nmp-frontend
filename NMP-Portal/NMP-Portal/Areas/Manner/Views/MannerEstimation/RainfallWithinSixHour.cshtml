@using NMP.Commons.Resources
@model NMP.Commons.ViewModels.MannerEstimationStep32ViewModel
@{

    string title = Resource.lblMannerEstimate;
    ViewData["Title"] = $"{Resource.lblRainfallWithin6Hours} {Resource.lblHyphen} {title}";
    ViewBag.CurrentStep = (int)NMP.Commons.Enums.OrganicManureWizardSteps.RainfallWithinSixHour;

}
@section BeforeContent {
    <govuk-back-link asp-action="ConditionsAffectingNutrients" asp-controller="MannerEstimation">@Resource.lblBack</govuk-back-link>
}


<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        @if (ViewBag.Error != null)
        {
            <govuk-error-summary>
                <govuk-error-summary-item href="#passport-issued-day">@ViewBag.Error</govuk-error-summary-item>
            </govuk-error-summary>
        }
        <form asp-action="RainfallWithinSixHour" asp-controller="MannerEstimation" method="post" autocomplete="off">
            @Html.AntiForgeryToken()
            <govuk-radios for="@Model.RainfallWithinSixHoursId">
                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @Resource.lblRainfallWithin6Hours
                    </govuk-radios-fieldset-legend>
                    <govuk-radios-hint>
                        @Resource.lblSelectOneOption                       
                    </govuk-radios-hint>
                    @if (ViewBag.RainTypes != null && ViewBag.RainTypes.Count > 0)
                    {
                        @foreach (var item in ViewBag.RainTypes)
                        {
                            <govuk-radios-item value="@item.ID">@item.Name</govuk-radios-item>
                        }
                    }
                </govuk-radios-fieldset>
            </govuk-radios>
            <govuk-button type="submit" class="margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
            <p class="govuk-body cancel-link">

           
                <a class="govuk-link" asp-action="MannerEstimationCancel" asp-controller="MannerEstimation">@Resource.lblCancel</a>

            </p>
        </form>
    </div>
</div>