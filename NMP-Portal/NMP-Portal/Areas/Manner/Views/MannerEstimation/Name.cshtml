@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep31ViewModel

@{
    string title = Resource.lblMannerEstimate;
    ViewData["Title"] = $"{Resource.lblWhatWouldYouLikeTocallThisEstimationReference} {Resource.lblHyphen} {title}";
    ViewBag.CurrentStep = (int)MannerEstimateWizardSteps.FarmName;
    string backAction = "MannerHubPage";
    string controller = "MannerEstimation";
    @if (Model.IsCopyEstimate.HasValue)
    {
        @if (Model.IsCopyEstimate.Value)
        {
            backAction = "CopyFromEstimates";
        }
        else if (Model.IsCopyEstimate == false)
        {
            backAction = "CopyEstimate";
        }
    }
    @if (!string.IsNullOrWhiteSpace(Model.EncryptedMannerEstimationId))
    {
        backAction = "MannerEstimationResult";
    }
    else if(!Model.IsAnyFarmExist)
    {
        backAction = "MannerFarmList";
    }
}

@section BeforeContent {
    <govuk-back-link asp-action=@backAction asp-controller="@controller" asp-route-q="@(backAction == "MannerEstimationResult" ? Model.EncryptedMannerEstimationId : Model.EncryptedMannerFarmId)" asp-route-r="@(backAction == "MannerFarmList" ? ViewBag.IsBack:"")">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="Name" method="post" asp-controller="MannerEstimation" autocomplete="off">
            @Html.AntiForgeryToken()
            <govuk-input for="@Model.Name">
                <govuk-input-label class="govuk-label--l" is-page-heading="true">@Resource.lblWhatWouldYouLikeTocallThisEstimationReference</govuk-input-label>
                <govuk-input-hint>@Resource.lblReferenceMustBeUniqueFromAnyPreviousEstimations</govuk-input-hint>
            </govuk-input>
            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>
        <partial name="_CancelLink" model="@Model.EncryptedMannerEstimationId" />
    </div>
</div>