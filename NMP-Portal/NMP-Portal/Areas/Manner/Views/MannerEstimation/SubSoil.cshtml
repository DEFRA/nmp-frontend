@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep19ViewModel

@{
    string title = Resource.lblMannerEstimate;
    string heading = string.Format(Resource.lblWhatIsTheSubSoilInFieldName, Model.FieldName);
    ViewData["Title"] = $"{heading} {Resource.lblHyphen} {title}";
    var backAction = (!string.IsNullOrWhiteSpace(Model.EncryptedMannerEstimateId)) ? "MannerEstimationResult" : "TopSoil";
}

@section BeforeContent {
    <govuk-back-link asp-action="@backAction" asp-controller="MannerEstimation" asp-route-q="@(backAction == "MannerEstimationResult" ? Model.EncryptedMannerEstimateId : null)">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="SubSoil" method="post" asp-controller="MannerEstimation" autocomplete="off">
            @Html.AntiForgeryToken()
            <govuk-radios for="@Model.SubSoilId">
                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @heading
                    </govuk-radios-fieldset-legend>
                    <govuk-radios-hint>@Resource.lblSelectOneOption</govuk-radios-hint>
                    @if (ViewBag.SubsoilList != null)
                    {
                        @foreach (var item in ViewBag.SubsoilList ?? Enumerable.Empty<dynamic>())
                        {
                            <govuk-radios-item value="@item.Value">
                                @item.Text
                            </govuk-radios-item>
                        }
                    }
                </govuk-radios-fieldset>
            </govuk-radios>

             <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button>
        </form>

        <partial name="_CancelLink" model="@Model.EncryptedMannerEstimateId" />
    </div>
</div>