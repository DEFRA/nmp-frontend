@using NMP.Commons.Enums
@using NMP.Commons.Resources
@using NMP.Commons.ViewModels
@model MannerEstimationStep9ViewModel

@{
    string title = Resource.lblMannerEstimate;
    string heading =string.Format(Resource.lblWhatCropAreYouApplyingThisOrganicMaterial,Resource.lblCropType.ToLower());
    ViewData["Title"] = $"{heading} {Resource.lblHyphen} {title}";
    var backAction = (!string.IsNullOrWhiteSpace(Model.EncryptedMannerEstimateId) && !Model.IsCropGroupChange) ? "MannerEstimationResult" : "CropGroup";
}
@section BeforeContent {
    <govuk-back-link asp-action="@backAction" asp-controller="MannerEstimation" asp-route-q="@(backAction == "MannerEstimationResult" ? Model.EncryptedMannerEstimateId : null)">@Resource.lblBack</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form asp-action="CropType" method="post" asp-controller="MannerEstimation" autocomplete="off">
            @Html.AntiForgeryToken()
            <govuk-radios for="@Model.CropTypeId">
                <govuk-radios-fieldset>
                    <govuk-radios-fieldset-legend is-page-heading="true" class="govuk-fieldset__legend--l">
                        @heading
                    </govuk-radios-fieldset-legend>
                    <govuk-radios-hint>
                        @Resource.lblSelectOneOptionTheseOptionsComeFromAHDB
                    </govuk-radios-hint>

                        @foreach (var item in ViewBag.CropTypeList)
                        {
                            <govuk-radios-item value="@item.CropTypeId">@item.CropType</govuk-radios-item>
                        }
                </govuk-radios-fieldset>
            </govuk-radios>

            <govuk-button type="submit" data-prevent-double-click="true" class="govuk-button margin-bottom-forty margin-bottom-forty">
                @Resource.lblContinue
            </govuk-button> 
        </form>

        <partial name="_CancelLink" model="@Model.EncryptedMannerEstimateId" />
    </div>
</div>